---
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
import Search from "@astrojs/starlight/components/Search.astro";
---

<StarlightPage
  frontmatter={{
    title: "ScheduleOnce Help Center",
    tableOfContents: false,
    template: "splash",
    head: [
      {
        tag: "link",
        attrs: { rel: "preconnect", href: "https://fonts.googleapis.com" },
      },
      {
        tag: "link",
        attrs: {
          rel: "preconnect",
          href: "https://fonts.gstatic.com",
          crossorigin: true,
        },
      },
      {
        tag: "link",
        attrs: {
          rel: "stylesheet",
          href: "https://fonts.googleapis.com/css2?family=Open+Sans:wght@400;600&display=swap",
        },
      },
    ],
  }}
  hasSidebar={false}
>
  <!-- ═══════════════════════════════════════════════
       HERO
  ═══════════════════════════════════════════════ -->
  <section class="lp-hero not-content">
    <h1 class="lp-hero-title">How can we help you today?</h1>
    <div class="lp-search-row">
      <div class="lp-search-wrap">
        <Search />
      </div>
      <button class="lp-ask-ai">
        Ask AI
        <svg
          width="14"
          height="14"
          viewBox="0 0 24 24"
          fill="currentColor"
          aria-hidden="true"
        >
          <path
            d="M12 2l2.09 6.26L20 10l-5.91 1.74L12 18l-2.09-6.26L4 10l5.91-1.74L12 2z"
          ></path>
          <path
            d="M5 3l.74 2.26L8 6l-2.26.74L5 9l-.74-2.26L2 6l2.26-.74L5 3zM19 15l.74 2.26L22 18l-2.26.74L19 21l-.74-2.26L16 18l2.26-.74L19 15z"
          ></path>
        </svg>
      </button>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════
       FEATURE CARDS (3-up)
  ═══════════════════════════════════════════════ -->
  <section class="lp-cards-section not-content">
    <div class="lp-cards-grid">
      <!-- Getting Started -->
      <article class="lp-card">
        <div class="lp-card-icon">
          <img
            src="/assets/so-icon-getting-started.svg"
            width="30"
            height="30"
            alt=""
            aria-hidden="true"
          />
        </div>
        <h3 class="lp-card-title">Getting Started</h3>
        <p class="lp-card-desc">
          New to ScheduleOnce? Learn the basics of scheduling, account setup,
          and trial management.
        </p>
        <ul class="lp-card-links">
          <li>
            <a
              href="/scheduleonce/introduction-to-booking-pages/getting-started-with-booking-pages/"
              >Introduction to Booking Pages</a
            >
          </li>
          <li>
            <a
              href="/scheduleonce/event-types-booking-pages/event-types/creating-an-event-type/"
              >Creating an Event Type</a
            >
          </li>
          <li>
            <a
              href="/scheduleonce/recommended-configuration/single-user-scenarios/introduction-to-single-user-scenarios/"
              >Recommended Configuration</a
            >
          </li>
        </ul>
      </article>

      <!-- Security & Compliance -->
      <article class="lp-card">
        <div class="lp-card-icon">
          <img
            src="/assets/so-icon-security.svg"
            width="30"
            height="30"
            alt=""
            aria-hidden="true"
          />
        </div>
        <h3 class="lp-card-title">Security &amp; Compliance</h3>
        <p class="lp-card-desc">
          GDPR, HIPAA compliance, and best practices for keeping your data
          secure.
        </p>
        <ul class="lp-card-links">
          <li>
            <a
              href="/scheduleonce/insights-operations/billing-subscription-management/managing-your-account/"
              >Account Management</a
            >
          </li>
          <li>
            <a
              href="/scheduleonce/managing-bookings/reassign/introduction-to-booking-reassignment/"
              >Managing Bookings</a
            >
          </li>
        </ul>
      </article>

      <!-- Developer Docs (dark card) -->
      <article class="lp-card lp-card--dark">
        <div class="lp-card-icon lp-card-icon--dark">
          <img
            src="/assets/so-icon-dev-docs.svg"
            width="30"
            height="30"
            alt=""
            aria-hidden="true"
          />
        </div>
        <h3 class="lp-card-title">Developer Docs</h3>
        <p class="lp-card-desc">
          Explore API references, webhooks, and client-side integration guides.
        </p>
        <ul class="lp-card-links lp-card-links--dark">
          <li>
            <a
              href="/integrations/automation/mcp-setup-connecting-oncehub-to-your-ai-assistant/"
              >API for Booking Pages
              <img
                src="/assets/so-icon-arrow.svg"
                width="18"
                height="18"
                alt=""
                aria-hidden="true"
              />
            </a>
          </li>
          <li>
            <a href="/integrations/automation/integrating-oncehub-with-n8n/"
              >Client Side API
              <img
                src="/assets/so-icon-arrow.svg"
                width="18"
                height="18"
                alt=""
                aria-hidden="true"
              />
            </a>
          </li>
          <li>
            <a href="/integrations/automation/"
              >Using API's
              <img
                src="/assets/so-icon-arrow.svg"
                width="18"
                height="18"
                alt=""
                aria-hidden="true"
              />
            </a>
          </li>
        </ul>
      </article>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════
       ONCEHUB CROSS-LINK BANNER
  ═══════════════════════════════════════════════ -->
  <section class="lp-oh-section not-content">
    <div class="lp-oh-banner">
      <p class="lp-oh-title">Need help with OnceHub?</p>
      <p class="lp-oh-desc">
        <a href="/">Click here</a> for full support and documentation for our OnceHub
        product suite.
      </p>
      <ul class="lp-oh-links">
        <li><a href="/">OnceHub Help Docs</a></li>
        <li>
          <a
            href="/getting-started/introduction-oncehub/introduction-to-oncehub/"
            >Getting Started with OnceHub</a
          >
        </li>
        <li><a href="/account-integrations/API/">OnceHub Developers</a></li>
      </ul>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════
       BOTTOM: TROUBLESHOOTING + SUPPORT
  ═══════════════════════════════════════════════ -->
  <section class="lp-bottom not-content">
    <!-- Common Troubleshooting -->
    <div class="lp-trouble">
      <h2 class="lp-section-heading">
        <span class="lp-section-icon" aria-hidden="true">
          <img
            src="/assets/so-icon-troubleshooting.svg"
            width="30"
            height="30"
            alt=""
          />
        </span>
        Common Troubleshooting
      </h2>
      <ul class="lp-trouble-list">
        <li class="lp-trouble-item">
          <a
            href="/scheduleonce/user-integrations/google-calendar-connection/troubleshooting/google-calendar-connection-issues/"
          >
            <div>
              <p class="lp-trouble-title">Calendar Connection Issues</p>
              <p class="lp-trouble-sub">
                Fix syncing errors with Google, Outlook, or iCloud
              </p>
            </div>
            <svg
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              aria-hidden="true"
              ><polyline points="9,18 15,12 9,6"></polyline></svg
            >
          </a>
        </li>
        <li class="lp-trouble-item">
          <a
            href="/scheduleonce/account-integrations/CRM/salesforce/introduction-to-the-salesforce-integration/"
          >
            <div>
              <p class="lp-trouble-title">Email Delivery Failures</p>
              <p class="lp-trouble-sub">
                Troubleshoot Corporate Mailbox and SMTP settings
              </p>
            </div>
            <svg
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              aria-hidden="true"
              ><polyline points="9,18 15,12 9,6"></polyline></svg
            >
          </a>
        </li>
        <li class="lp-trouble-item">
          <a
            href="/scheduleonce/account-integrations/payment-collection/paypal/oncehub-connector-for-paypal/"
          >
            <div>
              <p class="lp-trouble-title">Payment Collection Errors</p>
              <p class="lp-trouble-sub">
                Resolve issues with Stripe or PayPal integrations
              </p>
            </div>
            <svg
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              aria-hidden="true"
              ><polyline points="9,18 15,12 9,6"></polyline></svg
            >
          </a>
        </li>
      </ul>
    </div>

    <!-- Still need help? -->
    <div class="lp-support">
      <h2 class="lp-section-heading">
        <span class="lp-section-icon" aria-hidden="true">
          <img src="/assets/so-icon-help.svg" width="30" height="30" alt="" />
        </span>
        Still need help?
      </h2>
      <div class="lp-support-cards">
        <div class="lp-support-card">
          <div class="lp-support-icon">
            <img
              src="/assets/so-icon-live-chat.svg"
              width="30"
              height="30"
              alt=""
              aria-hidden="true"
            />
          </div>
          <h3>Live Chat</h3>
          <p>Chat with our support team in real-time.</p>
        </div>
        <div class="lp-support-card">
          <div class="lp-support-icon">
            <img
              src="/assets/so-icon-email.svg"
              width="30"
              height="30"
              alt=""
              aria-hidden="true"
            />
          </div>
          <h3>Email Support</h3>
          <p>Open a ticket and get a response within 24h.</p>
        </div>
      </div>
    </div>
  </section>
</StarlightPage>

<style>
  /* ── Extend content to full width (undo Starlight prose padding) ── */
  .lp-hero,
  .lp-cards-section,
  .lp-oh-section,
  .lp-bottom {
    margin-inline: calc(-1 * var(--sl-content-pad-x, 1.5rem));
    padding-inline: var(--sl-content-pad-x, 1.5rem);
  }

  /* ══════════════════════════════════════
     HERO
  ══════════════════════════════════════ */
  .lp-hero {
    text-align: center;
    padding-block: 5rem 5rem;
    background: var(--sl-color-bg, #fff);
    border-bottom: 1px solid #e5e7eb;
  }

  .lp-hero-title {
    font-family: "Open Sans", sans-serif;
    font-size: clamp(1.75rem, 3.5vw, 2.5rem);
    font-weight: 600;
    color: #4a4a4a;
    margin: 0 0 2.5rem;
    line-height: 1.6;
  }

  .lp-search-row {
    display: flex;
    align-items: stretch;
    gap: 0.625rem;
    max-width: 660px;
    margin-inline: auto;
  }

  .lp-search-wrap {
    flex: 1;
    min-width: 0;
  }

  .lp-ask-ai {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0 1.25rem;
    border: 1px solid #c8c8c8;
    border-radius: 0;
    font-family: "Open Sans", sans-serif;
    font-size: 1rem;
    font-weight: 400;
    color: #333;
    background: #fff;
    white-space: nowrap;
    text-decoration: none;
    transition: border-color 0.15s;
  }

  .lp-ask-ai:hover {
    border-color: #006bb1;
    text-decoration: none;
  }

  /* ══════════════════════════════════════
     CARDS GRID (3-up)
  ══════════════════════════════════════ */
  .lp-cards-section {
    padding-block: 1.875rem;
    background: var(--sl-color-bg, #fff);
  }

  .lp-cards-grid {
    display: grid;
    grid-template-columns: repeat(3, 346px);
    gap: 30px;
    max-width: 1100px;
    margin-inline: auto;
    justify-content: center;
  }

  @media (max-width: 1150px) {
    .lp-cards-grid {
      grid-template-columns: repeat(2, 346px);
    }
  }

  @media (max-width: 860px) {
    .lp-cards-grid {
      grid-template-columns: 1fr;
    }
  }

  .lp-card {
    width: 346px;
    height: 388px;
    border: 1px solid #f6f6f6;
    border-radius: 1rem;
    padding: 30px;
    background: #fff;
    display: flex;
    flex-direction: column;
    gap: 24px;
    box-shadow:
      0 1px 1.5px rgba(0, 0, 0, 0.1),
      0 1px 1px rgba(0, 0, 0, 0.1);
    transition: box-shadow 0.15s;
    overflow: hidden;
  }

  .lp-card:hover {
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.1);
  }

  .lp-card--dark {
    background: #232d43;
    border-color: #232d43;
  }

  .lp-card--dark:hover {
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.3);
  }

  .lp-card-icon {
    width: 3.75rem;
    height: 3.75rem;
    border-radius: 50%;
    background: #fff;
    box-shadow: 0 1px 3px rgba(167, 167, 167, 0.48);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #4b7a9e;
    flex-shrink: 0;
  }

  .lp-card-icon--dark {
    background: rgba(255, 255, 255, 0.2);
    box-shadow: none;
    color: #fff;
  }

  .lp-card-title {
    font-family: "Open Sans", sans-serif;
    font-size: 1.25rem;
    font-weight: 600;
    color: #333;
    margin: 0;
    line-height: 1.4;
  }

  .lp-card--dark .lp-card-title {
    color: #fff;
  }

  .lp-card-desc {
    font-family: "Open Sans", sans-serif;
    font-size: 16px;
    color: #333;
    margin: 0;
    line-height: 24px;
  }

  .lp-card--dark .lp-card-desc {
    color: #dbeafe;
  }

  .lp-card-links {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .lp-card-links li a {
    font-family: "Open Sans", sans-serif;
    font-size: 16px;
    line-height: 24px;
    color: #006bb1;
    text-decoration: none;
    font-weight: 400;
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
  }

  .lp-card-links li a:hover {
    text-decoration: underline;
  }

  .lp-card-links--dark li a {
    color: #fff;
    font-weight: 600;
    display: flex;
    align-items: center;
    gap: 0.375rem;
  }

  .lp-card-links--dark li a:hover {
    opacity: 0.85;
  }

  /* ══════════════════════════════════════
     ONCEHUB CROSS-LINK BANNER
  ══════════════════════════════════════ */
  .lp-oh-section {
    padding-block: 1.875rem;
    background: var(--sl-color-bg, #fff);
  }

  .lp-oh-banner {
    background: #f0f8fd;
    border: 1px solid #f3f4f6;
    border-radius: 1rem;
    padding: 1.875rem;
    max-width: 1060px;
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    gap: 0.8125rem;
  }

  .lp-oh-title {
    font-family: "Open Sans", sans-serif;
    font-weight: 600;
    font-size: 1.25rem;
    color: #333;
    margin: 0;
    line-height: 1.4;
  }

  .lp-oh-desc {
    font-family: "Open Sans", sans-serif;
    font-size: 1rem;
    color: #4a5565;
    margin: 0;
    line-height: 1.5;
  }

  .lp-oh-desc a {
    color: #006bb1;
    text-decoration: none;
  }

  .lp-oh-desc a:hover {
    text-decoration: underline;
  }

  .lp-oh-links {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .lp-oh-links a {
    font-family: "Open Sans", sans-serif;
    font-size: 1rem;
    color: #006bb1;
    text-decoration: none;
    font-weight: 400;
  }

  .lp-oh-links a:hover {
    text-decoration: underline;
  }

  /* ══════════════════════════════════════
     BOTTOM SECTION
  ══════════════════════════════════════ */
  .lp-bottom {
    padding: 3.125rem 1.9375rem;
    background: #f7f7f7;
    border-top: 1px solid #e5e7eb;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3.8125rem;
  }

  @media (max-width: 720px) {
    .lp-bottom {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }

  .lp-section-heading {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    font-family: "Open Sans", sans-serif;
    font-size: 1.5rem;
    font-weight: 600;
    color: #333;
    margin: 0 0 1.875rem;
    line-height: 2rem;
  }

  .lp-section-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: #333;
    width: 3.75rem;
    height: 3.75rem;
    flex-shrink: 0;
  }

  /* Troubleshooting list */
  .lp-trouble-list {
    list-style: none;
    padding: 0.0625rem;
    margin: 0;
    border: 1px solid #f6f6f6;
    border-radius: 1rem;
    overflow: hidden;
    background: #fff;
    box-shadow:
      0 1px 1.5px rgba(0, 0, 0, 0.1),
      0 1px 1px rgba(0, 0, 0, 0.1);
  }

  .lp-trouble-item {
    border-bottom: 1px solid #c8c8c8;
  }

  .lp-trouble-item:last-child {
    border-bottom: none;
  }

  .lp-trouble-item a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.875rem 1.125rem;
    text-decoration: none;
    color: inherit;
    transition: background 0.12s;
  }

  .lp-trouble-item a:hover {
    background: #f8fafc;
    text-decoration: none;
  }

  .lp-trouble-title {
    font-family: "Open Sans", sans-serif;
    font-size: 1rem;
    font-weight: 600;
    color: #333;
    margin: 0 0 0.625rem;
    line-height: 1.6;
  }

  .lp-trouble-sub {
    font-family: "Open Sans", sans-serif;
    font-size: 0.875rem;
    color: #666;
    margin: 0;
    line-height: 1.57;
  }

  .lp-trouble-item svg {
    color: #333;
    flex-shrink: 0;
  }

  /* Support cards */
  .lp-support-cards {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.875rem;
  }

  .lp-support-card {
    border: 1px solid #f6f6f6;
    border-radius: 1rem;
    padding: 1.4375rem 0.0625rem;
    text-align: center;
    background: #fff;
    box-shadow:
      0 1px 1.5px rgba(0, 0, 0, 0.1),
      0 1px 1px rgba(0, 0, 0, 0.1);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
    transition: box-shadow 0.15s;
  }

  .lp-support-card:hover {
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.1);
  }

  .lp-support-icon {
    width: 3.75rem;
    height: 3.75rem;
    border-radius: 50%;
    background: #fff;
    box-shadow: 0 1px 3px rgba(167, 167, 167, 0.48);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #4b7a9e;
  }

  .lp-support-card h3 {
    font-family: "Open Sans", sans-serif;
    font-size: 1.25rem;
    font-weight: 600;
    color: #333;
    margin: 0;
    line-height: 1.4;
  }

  .lp-support-card p {
    font-family: "Open Sans", sans-serif;
    font-size: 1rem;
    color: #333;
    margin: 0;
    line-height: 1.5;
    padding-inline: 1.25rem;
  }
</style>
