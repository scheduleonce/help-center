---
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
import { ScalarComponent } from "@scalar/astro";
---

<StarlightPage
  frontmatter={{
    title: "Booking Pages API Reference | ScheduleOnce Developer Center",
    tableOfContents: false,
    template: "splash",
  }}
  hasSidebar={false}
>
  <ScalarComponent
    renderMode="client"
    configuration={{
      url: "/scheduleonce/developers/api/booking-pages-api.yaml",
      metaData: {
        title: "Booking Pages API Reference | ScheduleOnce Developer Center",
      },
      documentDownloadType: "direct",
      hideDarkModeToggle: true,
      hideModels: true,
      showDeveloperTools: "never",
      theme: "none",
      _integration: "astro",
    }}
  />
</StarlightPage>

<style is:global>
  /* ═══════════════════════════════════════════════════════════════
     SCALAR THEME — map Starlight colour tokens to Scalar variables
     ═══════════════════════════════════════════════════════════════ */
  /* Define on :root and body so Scalar's body { background: var(--scalar-background-1) } inherits */
  :root,
  body,
  .scalar-api-reference,
  scalar-api-reference {
    /* Text */
    --scalar-color-1: var(--sl-color-white);
    --scalar-color-2: var(--sl-color-gray-2);
    --scalar-color-3: var(--sl-color-gray-3);
    --scalar-color-accent: var(--sl-color-accent);
    --scalar-color-disabled: var(--sl-color-gray-4);

    /* Backgrounds */
    --scalar-background-1: var(--sl-color-bg);
    --scalar-background-2: var(--sl-color-gray-6);
    --scalar-background-3: var(--sl-color-gray-6);
    --scalar-background-4: var(--sl-color-gray-6);
    --scalar-background-accent: var(--sl-color-accent-low);

    /* Borders */
    --scalar-border-color: var(--sl-color-gray-5);

    /* Buttons */
    --scalar-button-1: var(--sl-color-accent);
    --scalar-button-1-color: #ffffff;
    --scalar-button-1-hover: var(--sl-color-accent-high);

    /* Sidebar */
    --scalar-sidebar-color-1: var(--sl-color-gray-2);
    --scalar-sidebar-color-2: var(--sl-color-gray-3);
    --scalar-sidebar-border-color: var(--sl-color-gray-5);
    --scalar-sidebar-background-1: var(--sl-color-bg-sidebar);
    --scalar-sidebar-item-active-background: var(--sl-color-gray-6);

    /* Header */
    --scalar-header-background-1: var(--sl-color-bg-nav);

    /* Links */
    --scalar-link-color: var(--sl-color-accent);

    /* Font */
    --scalar-font: "Open Sans", sans-serif;
    --scalar-font-medium: "Open Sans", sans-serif;
    --scalar-font-code:
      "SF Mono", Monaco, "Cascadia Code", "Roboto Mono", monospace;
  }
</style>
