---
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
import GettingStartedIcon from "../assets/icons/icon-getting-started.svg";
import HumanEngagementIcon from "../assets/icons/icon-human-engagement.svg";
import InsightsIcon from "../assets/icons/icon-insights.svg";
import SecurityIcon from "../assets/icons/icon-security.svg";
import DevDocsIcon from "../assets/icons/icon-dev-docs.svg";
import ArrowIcon from "../assets/icons/oh-icon-arrow.svg";
---

<StarlightPage
  frontmatter={{
    title: "OnceHub Help Center",
    tableOfContents: false,
    template: "splash",
    head: [
      {
        tag: "link",
        attrs: { rel: "preconnect", href: "https://fonts.googleapis.com" },
      },
      {
        tag: "link",
        attrs: {
          rel: "preconnect",
          href: "https://fonts.gstatic.com",
          crossorigin: true,
        },
      },
      {
        tag: "link",
        attrs: {
          rel: "stylesheet",
          href: "https://fonts.googleapis.com/css2?family=Open+Sans:wght@400;600&display=swap",
        },
      },
    ],
  }}
  hasSidebar={false}
>
  <!-- ═══════════════════════════════════════════════
       HERO
  ═══════════════════════════════════════════════ -->
  <section class="lp-hero not-content">
    <h1 class="lp-hero-title">How can we help you today?</h1>
    <div class="lp-search-row">
      <div class="lp-search-wrap" style="cursor: pointer;">
        <svg
          class="lp-search-icon"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          aria-hidden="true"
        >
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
        <input
          type="text"
          class="lp-search-input"
          placeholder="Search OnceHub Documentation"
          readonly
          style="cursor: pointer;"
        />
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════
       FEATURE CARDS
  ═══════════════════════════════════════════════ -->
  <section class="lp-cards-section not-content">
    <div class="lp-cards-grid">
      <!-- Getting Started -->
      <article class="lp-card">
        <div class="lp-card-icon lp-card-icon--blue">
          <GettingStartedIcon aria-hidden="true" class="lp-card-svg" />
        </div>
        <h3 class="lp-card-title">Getting Started</h3>
        <p class="lp-card-desc">New to OnceHub? We're here to guide you.</p>
        <ul class="lp-card-links">
          <li>
            <a
              href="/getting-started/introduction-oncehub/introduction-to-oncehub/"
              >Getting Started</a
            >
          </li>
          <li>
            <a href="/profile-management/managing-your-profile-in-oncehub/"
              >Profile Management</a
            >
          </li>
          <li>
            <a
              href="/user-integrations/basics-user-integrations/connecting-your-productivity-suite-and-standalone-integrations/"
              >User Integrations</a
            >
          </li>
          <li>
            <a href="/account-administration/">Account Administration</a>
          </li>
        </ul>
      </article>

      <!-- AI Front Office Workers -->
      <!-- <article class="lp-card">
        <div class="lp-card-icon lp-card-icon--purple">
          <AiWorkersIcon aria-hidden="true" class="lp-card-svg" />
        </div>
        <h3 class="lp-card-title">AI Front Office Workers</h3>
        <p class="lp-card-desc">
          Access help articles according to our AI Products
        </p>
        <ul class="lp-card-links">
          <li>
            <a href="/ai-front-office-workers/phone-receptionist/"
              >Phone Receptionist</a
            >
          </li>
          <li>
            <a
              href="/ai-front-office-workers/website-assistant/chatbots/introduction-to-chatbots/"
              >Website Assistant</a
            >
          </li>
          <li>
            <a href="/ai-front-office-workers/meeting-coordinator/"
              >Meeting Coordinator</a
            >
          </li>
        </ul>
      </article> -->

      <!-- Human Engagement -->
      <article class="lp-card">
        <div class="lp-card-icon lp-card-icon--orange">
          <HumanEngagementIcon aria-hidden="true" class="lp-card-svg" />
        </div>
        <!-- <h3 class="lp-card-title">Human Engagement</h3> -->
        <h3 class="lp-card-title">Product</h3>
        <p class="lp-card-desc">
          Configure your scheduling and engagement solutions.
        </p>
        <ul class="lp-card-links">
          <li>
            <a
              href="/human-engagement/booking-calendars/introduction-to-booking-calendars/introduction-to-booking-calendars/"
              >Booking Calendars</a
            >
          </li>
          <li>
            <a
              href="/human-engagement/booking-hubs/introduction-to-booking-hubs/introduction-to-booking-hubs/"
              >Booking Hubs</a
            >
          </li>
          <li>
            <a
              href="/human-engagement/routing-forms/introduction-to-routing-forms/introduction-to-routing-forms/"
              >Routing Forms</a
            >
          </li>
          <li>
            <a
              href="/ai-front-office-workers/website-assistant/chatbots/introduction-to-chatbots/"
              >Chatbots</a
            >
          </li>
        </ul>
      </article>

      <!-- Insights & Operations -->
      <article class="lp-card">
        <div class="lp-card-icon lp-card-icon--green">
          <InsightsIcon aria-hidden="true" class="lp-card-svg" />
        </div>
        <h3 class="lp-card-title">Insights &amp; Operations</h3>
        <p class="lp-card-desc">
          Manage user access, booking operations and reporting.
        </p>
        <ul class="lp-card-links">
          <li>
            <a href="/contact-management/">Contact Management</a>
          </li>
          <li>
            <a
              href="/activities-analytics/reporting-analytics/booking-analytics/"
              >Reporting &amp; Analytics</a
            >
          </li>
          <li>
            <a href="/account-administration/user-management/"
              >User Management</a
            >
          </li>
          <li><a href="/billing/managing-your-subscription/">Billing</a></li>
        </ul>
      </article>

      <!-- Security & Compliance -->
      <article class="lp-card">
        <div class="lp-card-icon lp-card-icon--pink">
          <SecurityIcon aria-hidden="true" class="lp-card-svg" />
        </div>
        <h3 class="lp-card-title">Security &amp; Compliance</h3>
        <p class="lp-card-desc">
          Explore OnceHub standards for data security and regulatory compliance.
        </p>
        <ul class="lp-card-links">
          <li>
            <a href="/security-compliance/security/introduction-to-security/"
              >Security</a
            >
          </li>
          <li>
            <a href="/security-compliance/privacy/oncehub-cookies/">Privacy</a>
          </li>
          <li>
            <a href="/security-compliance/compliance/compliance-at-oncehub/"
              >Compliance</a
            >
          </li>
        </ul>
      </article>

      <!-- Developer Docs (dark card) -->
      <article class="lp-card lp-card--dark">
        <div class="lp-card-icon lp-card-icon--dark">
          <DevDocsIcon
            aria-hidden="true"
            class="lp-card-svg lp-card-svg--white"
          />
        </div>
        <h3 class="lp-card-title">Developers</h3>
        <p class="lp-card-desc">
          Everything developers need to build, customize, and automate
          scheduling workflows.
        </p>
        <ul class="lp-card-links lp-card-links--dark">
          <li>
            <a href="/developers/overview/introduction/"
              >Developer Docs
              <ArrowIcon aria-hidden="true" class="lp-card-arrow" />
            </a>
          </li>
          <li>
            <a href="/developers/api/"
              >API Reference
              <ArrowIcon aria-hidden="true" class="lp-card-arrow" />
            </a>
          </li>
        </ul>
      </article>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════
       SCHEDULEONCE BANNER
  ═══════════════════════════════════════════════ -->
  <section class="lp-so-section not-content">
    <div class="lp-so-banner">
      <h3 class="lp-so-title">Need help with ScheduleOnce?</h3>
      <p class="lp-so-desc">
        <a
          href="/scheduleonce/introduction-to-booking-pages/getting-started-with-booking-pages/"
          class="lp-so-link-inline">Click here</a
        >{" "}to access full support and documentation for our classic Booking
        Pages product suite.
      </p>
      <ul class="lp-so-links">
        <li>
          <a
            href="/scheduleonce/introduction-to-booking-pages/feature-comparison-booking-calendars-vs-booking-pages/"
            >ScheduleOnce (Booking Pages) vs OnceHub (Booking Calendars)</a
          >
        </li>
        <li>
          <a
            href="https://share.articulate.com/N-dNyJmVKntDuE-a9uBNM"
            target="_blank"
            rel="noopener noreferrer"
            >OnceHub Booking Calendars Adoption Guide</a
          >
        </li>
        <li>
          <a href="/scheduleonce/developers/">ScheduleOnce Developers</a>
        </li>
      </ul>
      <div class="lp-so-v1">
        <a href="/scheduleonce/developers/v1/" class="lp-so-link-inline"
          >ScheduleOnce API v1 (Deprecated)</a
        >
      </div>
    </div>
  </section>
  <section class="lp-bottom not-content">
    <div class="lp-container">
      <!-- Still need help? -->
      <div class="lp-support">
        <h2 class="lp-section-heading">
          <span class="lp-section-icon" aria-hidden="true">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              preserveAspectRatio="none"
              width="30"
              height="30"
              overflow="visible"
              style="display: block;"
              viewBox="0 0 30 30"
              fill="none"
            >
              <g id="help-library-circle">
                <path
                  id="Vector"
                  d="M15 1.375C22.5255 1.375 28.625 7.47446 28.625 15C28.625 22.5255 22.5255 28.625 15 28.625C7.47446 28.625 1.375 22.5255 1.375 15C1.375 7.47446 7.47446 1.375 15 1.375ZM15 3.125C8.44204 3.125 3.125 8.44204 3.125 15C3.125 21.558 8.44204 26.875 15 26.875C21.558 26.875 26.875 21.558 26.875 15C26.875 8.44204 21.558 3.125 15 3.125Z"
                  fill="var(--sl-color-accent)"
                  stroke="var(--sl-color-accent)"
                  stroke-width="0.25"></path>
                <path
                  id="Vector_2"
                  d="M13.4505 17.274V16.542C13.4505 15.909 13.5855 15.3585 13.8555 14.8905C14.1255 14.4225 14.6205 13.9245 15.339 13.398C16.0305 12.903 16.488 12.501 16.7085 12.192C16.929 11.883 17.04 11.5365 17.04 11.154C17.04 10.725 16.8825 10.3995 16.566 10.1745C16.2495 9.9495 15.8085 9.8385 15.2415 9.8385C14.253 9.8385 13.125 10.161 11.8605 10.8075L10.782 8.6415C12.252 7.818 13.8105 7.4055 15.459 7.4055C16.8165 7.4055 17.8965 7.7325 18.6975 8.385C19.4985 9.0375 19.899 9.9075 19.899 10.995C19.899 11.7195 19.734 12.3465 19.404 12.873C19.074 13.3995 18.4485 13.9935 17.526 14.6535C16.893 15.1215 16.4925 15.477 16.3245 15.7215C16.1565 15.966 16.0725 16.2855 16.0725 16.68V17.274H13.452H13.4505ZM13.134 20.6565C13.134 20.103 13.2825 19.6845 13.5795 19.401C13.8765 19.1175 14.3085 18.9765 14.8755 18.9765C15.423 18.9765 15.846 19.122 16.146 19.4115C16.446 19.701 16.596 20.1165 16.596 20.658C16.596 21.1785 16.4445 21.5895 16.1415 21.8895C15.8385 22.1895 15.417 22.3395 14.8755 22.3395C14.322 22.3395 13.893 22.1925 13.59 21.9C13.287 21.6075 13.1355 21.1935 13.1355 20.6595L13.134 20.6565Z"
                  fill="var(--sl-color-accent)"></path>
              </g>
            </svg>
          </span>
          Still need help?
        </h2>
        <div class="lp-support-cards">
          <a
            href="https://www.oncehub.com/live-chat-support"
            target="_blank"
            data-co-bot="BOT-F73E84CB6C"
            class="lp-support-card"
          >
            <div class="lp-support-icon">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                preserveAspectRatio="none"
                width="30"
                height="30"
                viewBox="0 0 30.25 30"
                fill="none"
              >
                <g id="live-chat-support">
                  <path
                    id="Vector"
                    d="M25.5035 7.37643L27.2017 7.42623H27.2105L27.4449 7.45065L27.4497 7.45162C28.9733 7.67195 30.1245 8.98088 30.1245 10.5434V21.0024L30.1177 21.226V21.2309L29.9927 21.2221L30.1167 21.2309C29.998 22.8483 28.648 24.1235 26.9995 24.1235H25.6245V27.0903L25.6158 27.2329L25.6148 27.2417C25.5375 27.8161 25.0454 28.2573 24.4497 28.2573H24.441L24.2886 28.2465L24.2788 28.2456C24.0543 28.2121 23.8427 28.1145 23.6714 27.9633L19.3335 24.1255H11.8745V22.3755H19.9947L20.0298 22.4067L23.8745 25.8071V22.3755H26.9927L27.1646 22.3647C27.846 22.2834 28.3743 21.7042 28.3745 21.0005V10.5454H28.3755L28.3658 10.3852H28.3648C28.293 9.76979 27.8196 9.24002 27.2144 9.1401L27.0904 9.12643H25.3745V7.37252L25.5035 7.37643ZM21.3033 2.8735L21.2876 2.88912C22.8792 3.03426 24.1245 4.37093 24.1245 6.00045V16.5005C24.1243 18.2268 22.7259 19.6255 20.9995 19.6255H12.2212L7.36088 24.352C7.23875 24.4707 7.08467 24.5517 6.91947 24.5835L6.90677 24.5854L6.76322 24.5981L6.7515 24.5991C6.32274 24.5991 5.96379 24.2895 5.89017 23.8813L5.88822 23.8706L5.8892 23.8696L5.87748 23.7348L5.87552 23.7241H5.8765V19.6235H4.5015C2.77496 19.6235 1.3765 18.225 1.3765 16.4985V5.9985C1.3765 4.27196 2.77496 2.8735 4.5015 2.8735H21.3033ZM20.9995 4.62448L4.49955 4.62545C3.79679 4.62568 3.21684 5.15221 3.13529 5.83151L3.12455 6.00729V16.5005C3.12477 17.2036 3.65276 17.7836 4.33255 17.8647L4.50736 17.8755H7.62552L7.62455 18.0005L7.62162 21.6557L11.4751 17.9106L11.5113 17.8755H20.9995C21.7032 17.8755 22.2841 17.3469 22.3648 16.6665L22.3755 16.5005H22.3745V6.00045C22.3745 5.29679 21.847 4.71489 21.1665 4.63424L20.9995 4.62448Z"
                    fill="currentColor"
                    stroke="currentColor"
                    stroke-width="0.25"></path>
                </g>
              </svg>
            </div>
            <h3>Live Chat</h3>
            <p>Chat with our support team in real-time.</p>
          </a>
          <a href="mailto:support@oncehub.com" class="lp-support-card">
            <div class="lp-support-icon">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                preserveAspectRatio="none"
                width="30"
                height="21"
                viewBox="0 0 30.8629 21.804"
                fill="none"
              >
                <g id="email-24 copy">
                  <rect
                    id="Rectangle 7"
                    x="1.15865"
                    y="1.13733"
                    width="28.5"
                    height="19.4961"
                    stroke="currentColor"
                    stroke-width="2"></rect>
                  <path
                    id="Path 6"
                    d="M1.38356 0.808736L15.3627 10.9754L29.3419 0.881911"
                    stroke="currentColor"
                    stroke-width="2"></path>
                  <path
                    id="Path 7"
                    d="M0.794066 21.1686L11.0083 7.82483"
                    stroke="currentColor"
                    stroke-width="2"></path>
                  <path
                    id="Path 7 Copy"
                    d="M30.0708 20.2553L20.492 7.82483"
                    stroke="currentColor"
                    stroke-width="2"></path>
                </g>
              </svg>
            </div>
            <h3>Email Support</h3>
            <p>Open a ticket and get a response within 24h.</p>
          </a>
        </div>
      </div>
    </div>
  </section>
</StarlightPage>

<style>
  /* ── Reset prose styles that Starlight injects ── */
  .lp-hero,
  .lp-cards-section,
  .lp-so-section,
  .lp-bottom {
    margin-inline: calc(-1 * var(--sl-content-pad-x, 1.5rem));
    padding-inline: var(--sl-content-pad-x, 1.5rem);
  }

  /* ══════════════════════════════════════
     HERO
  ══════════════════════════════════════ */
  .lp-hero {
    text-align: center;
    padding: 80px 32px 100px;
  }

  .lp-hero-title {
    font-family: "Open Sans", sans-serif;
    font-size: 40px !important;
    font-weight: 600 !important;
    color: #4a4a4a;
    margin: 0 0 40px !important;
    line-height: 1.6;
  }

  .lp-search-row {
    display: flex;
    align-items: stretch;
    gap: 10px;
    max-width: 600px;
    margin-inline: auto;
  }

  .lp-search-wrap {
    flex: 1;
    min-width: 0;
    position: relative;
  }

  .lp-search-input {
    width: 100%;
    height: 50px;
    border-radius: 28px;
    border: 1px solid var(--sl-hairline-color);
    background: var(--sl-cards-bg);
    padding: 0 20px 0 64px;
    font-family: "Open Sans", sans-serif;
    font-size: 16px;
    font-weight: 400;
    color: var(--sl-color-accent);
    outline: none;
    box-sizing: border-box;
    line-height: 24px;
  }

  .lp-search-input::placeholder {
    color: var(--sl-placeholder-color);
  }

  .lp-search-input:focus {
    border-color: var(--sl-color-accent, #006bb1);
  }

  .lp-search-icon {
    position: absolute;
    left: 20px;
    top: 50%;
    transform: translateY(-50%);
    width: 24px;
    height: 24px;
    pointer-events: none;
    color: var(--sl-placeholder-color);
  }

  /* ══════════════════════════════════════
     CARDS GRID
  ══════════════════════════════════════ */
  .lp-cards-section {
    padding: 30px 0px 0px;
    background: var(--sl-color-bg);
  }

  .lp-cards-grid {
    display: grid;
    grid-template-columns: repeat(3, 346px);
    gap: 30px;
    max-width: 1100px;
    margin-inline: auto;
    justify-content: center;
  }

  .lp-card {
    width: 346px;
    height: 388px;
    border: 1px solid var(--sl-card-color-hairline);
    border-radius: 1rem;
    padding: 30px;
    background: var(--sl-cards-bg);
    display: flex;
    flex-direction: column;
    gap: 24px;
    box-sizing: border-box;
    box-shadow:
      0 1px 1.5px rgba(0, 0, 0, 0.1),
      0 1px 1px rgba(0, 0, 0, 0.1);
    transition: box-shadow 0.15s;
    overflow: hidden;
  }

  .lp-card:hover {
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.1);
  }

  .lp-card--dark {
    background: var(--sl-card-color-dark-bg);
    border-color: var(--sl-card-color-dark-hairline);
    color: #fff;
  }
  .lp-card--dark p {
    color: #dbeafe;
  }

  .lp-card--dark:hover {
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.3);
  }

  .lp-card-icon {
    width: 3.75rem;
    height: 3.75rem;
    border-radius: 50%;
    /* box-shadow: 0 1px 6px rgba(167, 167, 167, 0.48); */
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .lp-card-icon--blue {
    background: var(--sl-card-icon-color-gs-bg);
    color: var(--sl-card-icon-color-gs);
    border: 2px solid var(--sl-card-icon-color-gs-hairline);
  }

  .lp-card-icon--purple {
    background: var(--sl-card-icon-color-ai-bg);
    color: var(--sl-card-icon-color-ai);
    border: 2px solid var(--sl-card-icon-color-ai-hairline);
  }

  .lp-card-icon--orange {
    background: var(--sl-card-icon-color-he-bg);
    color: var(--sl-card-icon-color-he);
    border: 2px solid var(--sl-card-icon-color-he-hairline);
  }

  .lp-card-icon--green {
    background: var(--sl-card-icon-color-io-bg);
    color: var(--sl-card-icon-color-io);
    border: 2px solid var(--sl-card-icon-color-io-hairline);
  }

  .lp-card-icon--pink {
    background: var(--sl-card-icon-color-sc-bg);
    color: var(--sl-card-icon-color-sc);
    border: 2px solid var(--sl-card-icon-color-sc-hairline);
  }

  .lp-card-icon--dark {
    background: var(--sl-card-icon-color-dd-bg);
    color: var(--sl-card-icon-color-dd);
    border: 2px solid var(--sl-card-icon-color-dd-hairline);
  }

  .lp-card-svg {
    width: 26px;
    height: 26px;
    display: block;
  }

  .lp-card-svg--white {
    width: 24px;
    height: 24px;
  }

  .lp-card-arrow {
    width: 18px;
    height: 18px;
    display: block;
    color: #fff;
  }

  .lp-card-title {
    font-family: "Open Sans", sans-serif;
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--sl-color-accent);
    margin: 0;
    line-height: 1.4;
  }

  .lp-card--dark .lp-card-title {
    color: #fff;
  }

  .lp-card-desc {
    font-family: "Open Sans", sans-serif;
    font-size: 16px;
    color: var(--sl-color-accent);
    margin: 0;
    line-height: 24px;
  }
  /*
  .lp-card--dark .lp-card-desc {
    color: #dbeafe;
  } */

  .lp-card-links {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .lp-card-links li {
    line-height: 1.5rem;
  }

  .lp-card-links li a {
    font-family: "Open Sans", sans-serif;
    font-size: 16px;
    line-height: 24px;
    color: var(--sl-oh-link-color);
    text-decoration: none;
    font-weight: 400;
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
  }

  .lp-card-links li a:hover {
    text-decoration: underline;
  }

  .lp-card-links--dark li a {
    color: #fff;
    display: flex;
    align-items: center;
