---
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
import Search from "@astrojs/starlight/components/Search.astro";
---

<StarlightPage
  frontmatter={{
    title: "OnceHub Help Center",
    tableOfContents: false,
    template: "splash",
    head: [
      {
        tag: "link",
        attrs: { rel: "preconnect", href: "https://fonts.googleapis.com" },
      },
      {
        tag: "link",
        attrs: {
          rel: "preconnect",
          href: "https://fonts.gstatic.com",
          crossorigin: true,
        },
      },
      {
        tag: "link",
        attrs: {
          rel: "stylesheet",
          href: "https://fonts.googleapis.com/css2?family=Open+Sans:wght@400;600&display=swap",
        },
      },
    ],
  }}
  hasSidebar={false}
>
  <!-- ═══════════════════════════════════════════════
       HERO
  ═══════════════════════════════════════════════ -->
  <section class="lp-hero not-content">
    <h1 class="lp-hero-title">How can we help you today?</h1>
    <div class="lp-search-row">
      <div class="lp-search-wrap">
        <Search />
      </div>
      <button class="lp-ask-ai">
        Ask AI
        <svg
          width="14"
          height="14"
          viewBox="0 0 24 24"
          fill="currentColor"
          aria-hidden="true"
        >
          <path
            d="M12 2l2.09 6.26L20 10l-5.91 1.74L12 18l-2.09-6.26L4 10l5.91-1.74L12 2z"
          ></path>
          <path
            d="M5 3l.74 2.26L8 6l-2.26.74L5 9l-.74-2.26L2 6l2.26-.74L5 3zM19 15l.74 2.26L22 18l-2.26.74L19 21l-.74-2.26L16 18l2.26-.74L19 15z"
          ></path>
        </svg>
      </button>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════
       FEATURE CARDS
  ═══════════════════════════════════════════════ -->
  <section class="lp-cards-section not-content">
    <div class="lp-cards-grid">
      <!-- Getting Started -->
      <article class="lp-card">
        <div class="lp-card-icon">
          <img
            src="/assets/oh-icon-getting-started.svg"
            width="30"
            height="30"
            alt=""
            aria-hidden="true"
          />
        </div>
        <h3 class="lp-card-title">Getting Started</h3>
        <p class="lp-card-desc">
          New to OnceHub? Learn the basics of scheduling, account setup, and
          trial management.
        </p>
        <ul class="lp-card-links">
          <li>
            <a
              href="/getting-started/introduction-oncehub/introduction-to-oncehub/"
              >Introduction to OnceHub</a
            >
          </li>
          <li>
            <a
              href="/getting-started/introduction-oncehub/signing-up-with-oncehub/"
              >Signing up with OnceHub</a
            >
          </li>
          <li><a href="/billing/managing-your-subscription/">Billing</a></li>
        </ul>
      </article>

      <!-- Products -->
      <article class="lp-card">
        <div class="lp-card-icon">
          <img
            src="/assets/oh-icon-products.svg"
            width="30"
            height="30"
            alt=""
            aria-hidden="true"
          />
        </div>
        <h3 class="lp-card-title">Products</h3>
        <p class="lp-card-desc">
          Access help articles according to our Product Offering
        </p>
        <ul class="lp-card-links">
          <li>
            <a
              href="/human-engagement/booking-calendars/introduction-to-booking-calendars/introduction-to-booking-calendars/"
              >Booking Calendars</a
            >
          </li>
          <li>
            <a
              href="/human-engagement/booking-hubs/introduction-to-booking-hubs/introduction-to-booking-hubs/"
              >Booking Hubs</a
            >
          </li>
          <li>
            <a
              href="/human-engagement/routing-forms/introduction-to-routing-forms/introduction-to-routing-forms/"
              >Routing Forms</a
            >
          </li>
          <li>
            <a
              href="/ai-front-office-workers/website-assistant/chatbots/introduction-to-chatbots/"
              >Chatbots</a
            >
          </li>
        </ul>
      </article>

      <!-- Integrations -->
      <article class="lp-card">
        <div class="lp-card-icon">
          <img
            src="/assets/oh-icon-integrations.svg"
            width="30"
            height="30"
            alt=""
            aria-hidden="true"
          />
        </div>
        <h3 class="lp-card-title">Integrations</h3>
        <p class="lp-card-desc">
          Configure integrations with third party tools, assisting in workload
          management for your team.
        </p>
        <ul class="lp-card-links">
          <li>
            <a
              href="/user-integrations/basics-user-integrations/connecting-your-productivity-suite-and-standalone-integrations/"
              >User Integrations</a
            >
          </li>
          <li>
            <a href="/account-integrations/crm/integrating-with-your-crm/"
              >Account Integrations</a
            >
          </li>
        </ul>
      </article>

      <!-- Insights & Operations -->
      <article class="lp-card">
        <div class="lp-card-icon">
          <img
            src="/assets/oh-icon-insights.svg"
            width="30"
            height="30"
            alt=""
            aria-hidden="true"
          />
        </div>
        <h3 class="lp-card-title">Insights &amp; Operations</h3>
        <p class="lp-card-desc">
          Manage your billing, users, and deep dive into booking analytics and
          reports.
        </p>
        <ul class="lp-card-links">
          <li>
            <a
              href="/activities-analytics/reporting-analytics/booking-analytics/"
              >Reporting</a
            >
          </li>
          <li>
            <a href="/billing/managing-your-subscription/"
              >Billing &amp; Subscriptions</a
            >
          </li>
        </ul>
      </article>

      <!-- Security & Compliance -->
      <article class="lp-card">
        <div class="lp-card-icon">
          <img
            src="/assets/oh-icon-security.svg"
            width="30"
            height="30"
            alt=""
            aria-hidden="true"
          />
        </div>
        <h3 class="lp-card-title">Security &amp; Compliance</h3>
        <p class="lp-card-desc">
          GDPR, HIPAA compliance, and best practices for keeping your data
          secure.
        </p>
        <ul class="lp-card-links">
          <li>
            <a href="/security-compliance/compliance/what-is-hipaa/"
              >Compliance Center</a
            >
          </li>
          <li>
            <a href="/security-compliance/privacy/gdpr-compliance/"
              >Data Privacy</a
            >
          </li>
        </ul>
      </article>

      <!-- Developer Docs (dark card) -->
      <article class="lp-card lp-card--dark">
        <div class="lp-card-icon lp-card-icon--dark">
          <img
            src="/assets/oh-icon-dev-docs.svg"
            width="30"
            height="30"
            alt=""
            aria-hidden="true"
          />
        </div>
        <h3 class="lp-card-title">Developer Docs</h3>
        <p class="lp-card-desc">
          Explore API references, webhooks, and client-side integration guides.
        </p>
        <ul class="lp-card-links lp-card-links--dark">
          <li>
            <a
              href="/scheduleonce/account-integrations/api/custom-integrations-with-oncehub-api/"
              >API for Booking Calendars
              <img
                src="/assets/oh-icon-arrow.svg"
                width="18"
                height="18"
                alt=""
                aria-hidden="true"
              />
            </a>
          </li>
          <li>
            <a
              href="/account-integrations/automation/custom-booking-calendar-integrations-with-webhooks-and-apis/"
              >Client Side API
              <img
                src="/assets/oh-icon-arrow.svg"
                width="18"
                height="18"
                alt=""
                aria-hidden="true"
              />
            </a>
          </li>
        </ul>
      </article>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════
       SCHEDULEONCE BANNER
  ═══════════════════════════════════════════════ -->
  <section class="lp-so-section not-content">
    <div class="lp-so-banner">
      <div class="lp-so-inner">
        <div>
          <p class="lp-so-title">Need help with ScheduleOnce?</p>
          <p class="lp-so-desc">
            We still offer full support and documentation for our classic
            product suite.
          </p>
        </div>
        <ul class="lp-so-links">
          <li><a href="/scheduleonce/">Classic Help Docs</a></li>
          <li>
            <a
              href="/getting-started/introduction-oncehub/introduction-to-oncehub/"
              >Migration Guide</a
            >
          </li>
          <li>
            <a
              href="/scheduleonce/account-integrations/api/custom-integrations-with-oncehub-api/"
              >ScheduleOnce Developers</a
            >
          </li>
        </ul>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════
       BOTTOM: TROUBLESHOOTING + SUPPORT
  ═══════════════════════════════════════════════ -->
  <section class="lp-bottom not-content">
    <!-- Common Troubleshooting -->
    <div class="lp-trouble">
      <h2 class="lp-section-heading">
        <span class="lp-section-icon" aria-hidden="true">
          <img
            src="/assets/oh-icon-troubleshooting.svg"
            width="30"
            height="30"
            alt=""
          />
        </span>
        Common Troubleshooting
      </h2>
      <ul class="lp-trouble-list">
        <li class="lp-trouble-item">
          <a
            href="/scheduleonce/user-integrations/google-calendar-connection/troubleshooting/google-calendar-connection-issues/"
          >
            <div>
              <p class="lp-trouble-title">Calendar Connection Issues</p>
              <p class="lp-trouble-sub">
                Fix syncing errors with Google, Outlook, or iCloud
              </p>
            </div>
            <svg
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              aria-hidden="true"
              ><polyline points="9,18 15,12 9,6"></polyline></svg
            >
          </a>
        </li>
        <li class="lp-trouble-item">
          <a
            href="/account-integrations/corporate-mailbox/sending-scheduling-notifications-from-custom-corporate-smtp-server/"
          >
            <div>
              <p class="lp-trouble-title">Email Delivery Failures</p>
              <p class="lp-trouble-sub">
                Troubleshoot Corporate Mailbox and SMTP settings
              </p>
            </div>
            <svg
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              aria-hidden="true"
              ><polyline points="9,18 15,12 9,6"></polyline></svg
            >
          </a>
        </li>
        <li class="lp-trouble-item">
          <a
            href="/account-integrations/payment-collection/stripe/introduction-to-stripe-integration/"
          >
            <div>
              <p class="lp-trouble-title">Payment Collection Errors</p>
              <p class="lp-trouble-sub">
                Resolve issues with Stripe or PayPal integrations
              </p>
            </div>
            <svg
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              aria-hidden="true"
              ><polyline points="9,18 15,12 9,6"></polyline></svg
            >
          </a>
        </li>
      </ul>
    </div>

    <!-- Still need help? -->
    <div class="lp-support">
      <h2 class="lp-section-heading">
        <span class="lp-section-icon" aria-hidden="true">
          <img src="/assets/oh-icon-help.svg" width="30" height="30" alt="" />
        </span>
        Still need help?
      </h2>
      <div class="lp-support-cards">
        <div class="lp-support-card">
          <div class="lp-support-icon">
            <img
              src="/assets/oh-icon-live-chat.svg"
              width="30"
              height="30"
              alt=""
              aria-hidden="true"
            />
          </div>
          <h3>Live Chat</h3>
          <p>Chat with our support team in real-time.</p>
        </div>
        <div class="lp-support-card">
          <div class="lp-support-icon">
            <img
              src="/assets/oh-icon-email.svg"
              width="30"
              height="30"
              alt=""
              aria-hidden="true"
            />
          </div>
          <h3>Email Support</h3>
          <p>Open a ticket and get a response within 24h.</p>
        </div>
      </div>
    </div>
  </section>
</StarlightPage>

<style>
  /* ── Reset prose styles that Starlight injects ── */
  .lp-hero,
  .lp-cards-section,
  .lp-so-section,
  .lp-bottom {
    margin-inline: calc(-1 * var(--sl-content-pad-x, 1.5rem));
    padding-inline: var(--sl-content-pad-x, 1.5rem);
  }

  /* ══════════════════════════════════════
     HERO
  ══════════════════════════════════════ */
  .lp-hero {
    text-align: center;
    padding-block: 3.5rem 3rem;
    background: var(--sl-color-bg, #fff);
    border-bottom: 1px solid var(--sl-color-hairline-light, #e5e7eb);
  }

  .lp-hero-title {
    font-family: "Open Sans", sans-serif;
    font-size: clamp(1.75rem, 3.5vw, 2.5rem);
    font-weight: 600;
    color: #4a4a4a;
    margin: 0 0 2rem;
    line-height: 1.6;
  }

  .lp-search-row {
    display: flex;
    align-items: stretch;
    gap: 0.625rem;
    max-width: 640px;
    margin-inline: auto;
  }

  .lp-search-wrap {
    flex: 1;
    min-width: 0;
  }

  /* Make Starlight's search button look like a full-width input */
  .lp-search-wrap :global(button.pagefind-ui__search-input),
  .lp-search-wrap :global([data-pagefind-ui] button),
  .lp-search-wrap :global(site-search button) {
    width: 100%;
    border-radius: 0.5rem;
    border: 1.5px solid #d1d5db;
    background: #fff;
    padding: 0.75rem 1rem;
    font-size: 0.9375rem;
    text-align: left;
    color: #9ca3af;
  }

  .lp-ask-ai {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0 1.25rem;
    border: 1px solid #c8c8c8;
    border-radius: 0;
    font-size: 1rem;
    font-weight: 400;
    color: #333;
    background: #fff;
    white-space: nowrap;
    text-decoration: none;
    transition:
      border-color 0.15s,
      background 0.15s;
  }

  .lp-ask-ai:hover {
    border-color: var(--sl-color-accent, #3b82f6);
    background: var(--sl-color-bg-sidebar, #f8fafc);
    text-decoration: none;
  }

  /* ══════════════════════════════════════
     CARDS GRID
  ══════════════════════════════════════ */
  .lp-cards-section {
    padding-block: 30px 60px;
    background: var(--sl-color-bg, #fff);
  }

  .lp-cards-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 30px;
    max-width: 1100px;
    margin-inline: auto;
    justify-content: center;
  }

  .lp-card {
    width: 346px;
    height: 388px;
    border: 1px solid #f6f6f6;
    border-radius: 1rem;
    padding: 1.875rem;
    background: #fff;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    box-shadow:
      0 1px 1.5px rgba(0, 0, 0, 0.1),
      0 1px 1px rgba(0, 0, 0, 0.1);
    transition: box-shadow 0.15s;
    box-sizing: border-box;
    overflow: hidden;
  }

  .lp-card:hover {
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.1);
  }

  .lp-card--dark {
    background: #232d43;
    border-color: #232d43;
    color: #fff;
  }

  .lp-card--dark:hover {
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.3);
  }

  .lp-card-icon {
    width: 3.75rem;
    height: 3.75rem;
    border-radius: 50%;
    background: #fff;
    box-shadow: 0 1px 3px rgba(167, 167, 167, 0.48);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #4b7a9e;
    flex-shrink: 0;
  }

  .lp-card-icon--dark {
    background: rgba(255, 255, 255, 0.2);
    box-shadow: none;
    color: #fff;
  }

  .lp-card-title {
    font-family: "Open Sans", sans-serif;
    font-size: 1.25rem;
    font-weight: 600;
    color: #333;
    margin: 0;
    line-height: 1.4;
  }

  .lp-card--dark .lp-card-title {
    color: #fff;
  }

  .lp-card-desc {
    font-family: "Open Sans", sans-serif;
    font-size: 1rem;
    color: #333;
    margin: 0;
    line-height: 1.5;
    flex: 1;
  }

  .lp-card--dark .lp-card-desc {
    color: #dbeafe;
  }

  .lp-card-links {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .lp-card-links li a {
    font-family: "Open Sans", sans-serif;
    font-size: 1rem;
    color: #006bb1;
    text-decoration: none;
    font-weight: 400;
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
  }

  .lp-card-links li a:hover {
    text-decoration: underline;
  }

  .lp-card-links--dark li a {
    color: #fff;
    font-weight: 600;
    display: flex;
    align-items: center;
    gap: 0.375rem;
  }

  .lp-card-links--dark li a:hover {
    opacity: 0.85;
  }

  /* ══════════════════════════════════════
     SCHEDULEONCE BANNER
  ══════════════════════════════════════ */
  .lp-so-section {
    padding-block: 1.875rem;
    background: var(--sl-color-bg, #fff);
  }

  .lp-so-banner {
    background: #f0f8fd;
    border: 1px solid #f3f4f6;
    border-radius: 1rem;
    padding: 1.875rem;
    max-width: 1060px;
    margin: 0 auto;
  }

  .lp-so-inner {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem 3rem;
    align-items: flex-start;
  }

  .lp-so-title {
    font-family: "Open Sans", sans-serif;
    font-weight: 600;
    font-size: 1.25rem;
    color: #333;
    margin: 0 0 0.5rem;
    line-height: 1.4;
  }

  .lp-so-desc {
    font-family: "Open Sans", sans-serif;
    font-size: 1rem;
    color: #4a5565;
    margin: 0;
    line-height: 1.5;
  }

  .lp-so-links {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .lp-so-links a {
    font-family: "Open Sans", sans-serif;
    font-size: 1rem;
    color: #006bb1;
    text-decoration: none;
    font-weight: 400;
  }

  .lp-so-links a:hover {
    text-decoration: underline;
  }

  /* ══════════════════════════════════════
     BOTTOM SECTION
  ══════════════════════════════════════ */
  .lp-bottom {
    padding: 3.125rem 1.9375rem;
    background: #f7f7f7;
    border-top: 1px solid #e5e7eb;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3.8125rem;
  }

  @media (max-width: 720px) {
    .lp-bottom {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    .lp-cards-grid {
      grid-template-columns: 1fr;
    }
  }

  .lp-section-heading {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    font-family: "Open Sans", sans-serif;
    font-size: 1.5rem;
    font-weight: 600;
    color: #333;
    margin: 0 0 1.875rem;
    line-height: 2rem;
  }

  .lp-section-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: #333;
    width: 3.75rem;
    height: 3.75rem;
    flex-shrink: 0;
  }

  /* Troubleshooting list */
  .lp-trouble-list {
    list-style: none;
    padding: 0.0625rem;
    margin: 0;
    border: 1px solid #f6f6f6;
    border-radius: 1rem;
    overflow: hidden;
    background: #fff;
    box-shadow:
      0 1px 1.5px rgba(0, 0, 0, 0.1),
      0 1px 1px rgba(0, 0, 0, 0.1);
  }

  .lp-trouble-item {
    border-bottom: 1px solid #c8c8c8;
  }

  .lp-trouble-item:last-child {
    border-bottom: none;
  }

  .lp-trouble-item a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.875rem 1.125rem;
    text-decoration: none;
    color: inherit;
    transition: background 0.12s;
  }

  .lp-trouble-item a:hover {
    background: #f8fafc;
    text-decoration: none;
  }

  .lp-trouble-title {
    font-family: "Open Sans", sans-serif;
    font-size: 1rem;
    font-weight: 600;
    color: #333;
    margin: 0 0 0.625rem;
    line-height: 1.6;
  }

  .lp-trouble-sub {
    font-family: "Open Sans", sans-serif;
    font-size: 0.875rem;
    color: #666;
    margin: 0;
    line-height: 1.57;
  }

  .lp-trouble-item svg {
    color: #333;
    flex-shrink: 0;
  }

  /* Support cards */
  .lp-support-cards {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.875rem;
  }

  .lp-support-card {
    border: 1px solid #f6f6f6;
    border-radius: 1rem;
    padding: 1.4375rem 0.0625rem;
    text-align: center;
    background: #fff;
    box-shadow:
      0 1px 1.5px rgba(0, 0, 0, 0.1),
      0 1px 1px rgba(0, 0, 0, 0.1);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
    transition: box-shadow 0.15s;
  }

  .lp-support-card:hover {
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.1);
  }

  .lp-support-icon {
    width: 3.75rem;
    height: 3.75rem;
    border-radius: 50%;
    background: #fff;
    box-shadow: 0 1px 3px rgba(167, 167, 167, 0.48);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #4b7a9e;
  }

  .lp-support-card h3 {
    font-family: "Open Sans", sans-serif;
    font-size: 1.25rem;
    font-weight: 600;
    color: #333;
    margin: 0;
    line-height: 1.4;
  }

  .lp-support-card p {
