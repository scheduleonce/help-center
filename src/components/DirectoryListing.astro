---
/**
 * DirectoryListing — renders immediate children of a category folder.
 *
 * - Sub-directories appear as category cards (links to their index page, or
 *   if no index exists, to the first article inside them).
 * - Direct articles appear as article links.
 *
 * Usage in an index.mdx category page:
 *
 *   import DirectoryListing from '~/components/DirectoryListing.astro';
 *   <DirectoryListing />
 */
import { getCollection, getEntry } from 'astro:content';

interface Props {
  /** Override the directory to list (defaults to current page's folder). */
  folder?: string;
}

let { folder } = Astro.props;

if (!folder) {
  const slug = (Astro.params.slug as string) ?? '';
  folder = slug.replace(/\/index$/, '').replace(/\/$/, '');
}
folder = folder.replace(/^\/|\/$/g, '');

const baseDepth = folder ? folder.split('/').length : 0;
const childDepth = baseDepth + 1;

/** Convert kebab slug segment → Title Case. */
function toTitle(seg: string): string {
  return seg.split('-').map((w) => w.charAt(0).toUpperCase() + w.slice(1)).join(' ');
}

// All non-hidden pages under this folder (excluding the index itself)
const allPages = await getCollection('docs', (page) => {
  if (!page.id.startsWith(folder + '/')) return false;
  if (page.id === folder + '/index') return false;
  if (page.data.sidebar?.hidden) return false;
  return true;
});

// Group pages by their immediate child path (at childDepth segments)
const groups = new Map<string, { pages: typeof allPages; isDirGroup: boolean }>();

for (const page of allPages) {
  const segs = page.id.split('/');
  const childKey = segs.slice(0, childDepth).join('/');
  // Skip the index file for any child directory
  if (segs.length === childDepth && segs[childDepth - 1] === 'index') continue;

  if (!groups.has(childKey)) {
    groups.set(childKey, { pages: [], isDirGroup: segs.length > childDepth });
  }
  const g = groups.get(childKey)!;
  g.pages.push(page);
  // Mark as a directory group if any contained page lives deeper
  if (segs.length > childDepth) g.isDirGroup = true;
}

// Build renderable items
type Item =
  | { kind: 'article'; title: string; description?: string; href: string; order: number }
  | { kind: 'category'; label: string; description?: string; href: string; count: number; order: number };

const items: Item[] = [];

for (const [childPath, { pages, isDirGroup }] of groups) {
  const dirName = childPath.split('/').at(-1)!;

  if (!isDirGroup) {
    // Direct article(s) at this child path — show each individually
    for (const page of pages) {
      items.push({
        kind: 'article',
        title: page.data.title,
        description: page.data.description,
        href: `/${page.id}/`,
        order: page.data.sidebar?.order ?? 999,
      });
    }
  } else {
    // Sub-directory: resolve the best href
    const indexEntry =
      (await getEntry('docs', `${childPath}/index`)) ??
      (await getEntry('docs', childPath));

    let href: string;
    if (indexEntry) {
      href = `/${childPath}/`;
    } else {
      // No index page — link to the first (lowest-order) article inside
      const sorted = [...pages].sort(
        (a, b) => (a.data.sidebar?.order ?? 999) - (b.data.sidebar?.order ?? 999)
      );
      href = `/${sorted[0].id}/`;
    }

    // Use the index page title if available, otherwise derive from dir name
    const label = indexEntry?.data.title ?? toTitle(dirName);
    const description = indexEntry?.data.description;

    // Order by the minimum order of contained articles
    const minOrder = Math.min(...pages.map((p) => p.data.sidebar?.order ?? 999));

    items.push({
      kind: 'category',
      label,
      description,
      href,
      count: pages.length,
      order: minOrder,
    });
  }
}

items.sort((a, b) => a.order - b.order || a.title?.localeCompare(b.title ?? '') || 0);
---

{items.length > 0 ? (
  <ul class="directory-listing not-content">
    {items.map((item) => (
      <li>
        {item.kind === 'category' ? (
          <a href={item.href} class="dl-category">
            <span class="dl-category-icon" aria-hidden="true">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
              </svg>
            </span>
            <span class="dl-body">
              <strong>{item.label}</strong>
              {item.description && <span class="dl-desc">{item.description}</span>}
            </span>
            <span class="dl-count">{item.count} article{item.count !== 1 ? 's' : ''}</span>
          </a>
        ) : (
          <a href={item.href} class="dl-article">
            <span class="dl-body">
              <strong>{item.title}</strong>
              {item.description && <span class="dl-desc">{item.description}</span>}
            </span>
          </a>
        )}
      </li>
    ))}
  </ul>
) : (
  <p><em>No articles found in this section.</em></p>
)}

<style>
  .directory-listing {
    list-style: none;
    padding: 0;
    margin: 1.5rem 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .dl-category,
  .dl-article {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.875rem 1.25rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.5rem;
    text-decoration: none;
    color: inherit;
    transition: border-color 0.15s, box-shadow 0.15s;
  }

  .dl-category:hover,
  .dl-article:hover {
    border-color: var(--sl-color-accent);
    box-shadow: var(--sl-shadow-sm);
  }

  .dl-category-icon {
    flex-shrink: 0;
    color: var(--sl-color-accent);
    display: flex;
  }

  .dl-body {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    min-width: 0;
  }

  .dl-body strong {
    color: var(--sl-color-white);
    font-size: var(--sl-text-base);
  }

  .dl-desc {
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-2);
    line-height: 1.5;
  }

  .dl-count {
    flex-shrink: 0;
    font-size: var(--sl-text-xs);
    color: var(--sl-color-gray-3);
    white-space: nowrap;
  }
</style>
