---
import SidebarRestorePoint from "@astrojs/starlight/components/SidebarRestorePoint.astro";

// Infer the sidebar entry type from the actual Starlight runtime data,
// avoiding fragile imports of Starlight's internal type modules.
const { sidebar } = Astro.locals.starlightRoute;
type SidebarEntry = (typeof sidebar)[number];

interface Props {
  sublist: SidebarEntry[];
  nested?: boolean;
  depth?: number;
}

const { sublist, nested, depth = nested ? 1 : 0 } = Astro.props;

const currentPath = Astro.url.pathname;

// ── Index-page helpers ──────────────────────────────────────────────────────
// When visiting a section index page (e.g. /developers/overview/) no sidebar
// link has `isCurrent`.  We match the last URL segment against group labels
// to expand and highlight the correct section.

const pathSegments = currentPath.split("/").filter(Boolean);
const lastSegment = pathSegments[pathSegments.length - 1] || "";

function labelToSlug(label: string): string {
  return label.toLowerCase().replace(/\s+/g, "-");
}

/** True if no link in the tree has `isCurrent` — we're on an index page. */
function isIndexPage(entries: SidebarEntry[]): boolean {
  for (const e of entries) {
    if (e.type === "link" && e.isCurrent) return false;
    if (e.type === "group" && !isIndexPage(e.entries)) return false;
  }
  return true;
}

/**
 * True when a group (or one of its descendants) has a label whose kebab-case
 * slug matches `lastSegment`.  This tells us the group represents the section
 * the user is currently viewing via its index page.
 */
function labelMatchesSegment(e: SidebarEntry): boolean {
  if (e.type === "group") {
    if (labelToSlug(e.label) === lastSegment) return true;
    return e.entries.some((c: SidebarEntry) => labelMatchesSegment(c));
  }
  return false;
}

const onIndexPage = isIndexPage(sublist);
// ────────────────────────────────────────────────────────────────────────────

function isExpanded(e: SidebarEntry): boolean {
  if (e.type === "group") {
    if (
      e.entries.some(
        (c: SidebarEntry) =>
          isExpanded(c) || (c.type === "link" && c.isCurrent),
      )
    )
      return true;
    // On index pages, suppress the default expansion — only keep the
    // matching section open so unrelated groups stay collapsed.
    if (onIndexPage) return labelMatchesSegment(e);
    return !e.collapsed;
  }
  return false;
}

/** Whether this entry or any descendant link is the current page. */
function hasActiveDescendant(e: SidebarEntry): boolean {
  if (e.type === "link") return e.isCurrent;
  // On an index page, highlight groups whose label matches the URL segment
  if (onIndexPage && labelMatchesSegment(e)) return true;
  return e.entries.some((c: SidebarEntry) => hasActiveDescendant(c));
}
---

<ul class:list={{ "sidebar-list": true, "sidebar-list--top": !nested }}>
  {
    sublist.map((entry: SidebarEntry) => (
      <li>
        {entry.type === "link" ? (
          <a
            href={entry.href}
            aria-current={entry.isCurrent ? "page" : undefined}
            class:list={{
              "sidebar-item": true,
              "sidebar-item--active": Boolean(entry.isCurrent),
              "sidebar-item--indent-1": depth >= 1,
              "sidebar-item--indent-2": depth >= 2,
              "sidebar-item--indent-3": depth >= 3,
              "sidebar-item--indent-4": depth >= 4,
            }}
            {...entry.attrs}
          >
            <span class="sidebar-item-label">{entry.label}</span>
          </a>
        ) : (
          <details class="sidebar-group" open={isExpanded(entry)}>
            <summary
              class:list={{
                "sidebar-summary": true,
                "sidebar-summary--active": hasActiveDescendant(entry),
                "sidebar-summary--indent-1": depth >= 1,
                "sidebar-summary--indent-2": depth >= 2,
                "sidebar-summary--indent-3": depth >= 3,
                "sidebar-summary--indent-4": depth >= 4,
              }}
            >
              <span class="sidebar-item-label">{entry.label}</span>
              <svg
                class="sidebar-chevron"
                viewBox="0 0 14 14"
                fill="none"
                aria-hidden="true"
              >
                <path
                  d="M5.25 2.625L9.625 7L5.25 11.375"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
            </summary>
            <SidebarRestorePoint />
            <div class="sidebar-group-children">
              {entry.entries.length > 0 && (
                <Astro.self sublist={entry.entries} nested depth={depth + 1} />
              )}
            </div>
          </details>
        )}
      </li>
    ))
  }
</ul>
