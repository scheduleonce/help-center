---
import type { CollectionEntry } from "astro:content";
import { getCollection, getEntry } from "astro:content";

interface Props {
  /** The content directory slug, e.g. "profile-management/availability" */
  directory: string;
}

const { directory } = Astro.props;

const allDocs = await getCollection("docs");
const prefix = directory + "/";

// Separate entries into immediate articles and subcategory names
const directArticles: CollectionEntry<"docs">[] = [];
const subdirNames = new Set<string>();

for (const entry of allDocs) {
  if (!entry.id.startsWith(prefix)) continue;

  const relative = entry.id.slice(prefix.length);
  const slashIndex = relative.indexOf("/");

  if (slashIndex === -1) {
    // Direct child — article in this directory
    // Starlight normalises index-page IDs (e.g. "client-side-api/index" → "client-side-api"),
    // so we defer the "is it an index?" check until we know the subdirectory names.
    directArticles.push(entry);
  } else {
    // Child in a subdirectory — record the subcategory name
    const subdir = relative.slice(0, slashIndex);
    if (subdir) subdirNames.add(subdir);
  }
}

// Now that we know the subdirectory names, remove any "direct article" that is
// actually an index page for a subcategory (Starlight normalises /index away).
const filteredArticles = directArticles.filter((entry) => {
  const relative = entry.id.slice(prefix.length);
  // Strip file extension to get the base name
  const baseName = relative.replace(/\.\w+$/, "");
  return !subdirNames.has(baseName);
});

// For each subcategory, look for an index page to get its title
interface Subcategory {
  name: string;
  title: string;
  href: string;
}

const subcategories: Subcategory[] = [];
for (const name of subdirNames) {
  const indexEntry =
    (await getEntry("docs", `${directory}/${name}/index`)) ??
    (await getEntry("docs", `${directory}/${name}`));
  if (indexEntry) {
    subcategories.push({
      name,
      title: indexEntry.data.title,
      href: `/${directory}/${name}/`,
    });
  }
}

// ── Sidebar-order helpers ───────────────────────────────────────────────────
// Order matches sidebar navigation via the sidebar config tree.
// The tree-walking logic lives in a separate module so it can be tested
// independent of the rendering.

import { getChildOrder } from "~/utils/getChildOrder";

// ── Determine display order ─────────────────────────────────────────────────
// Priority: 1) sidebar config order (explicit slugs/groups), 2) sidebar.order
// frontmatter, 3) alphabetical fallback.

const sidebarOrder = getChildOrder(directory);

/** Sort by sidebar.order frontmatter, then alphabetical. */
function sortArticles(articles: CollectionEntry<"docs">[]): void {
  articles.sort((a, b) => {
    const aOrder = a.data.sidebar?.order;
    const bOrder = b.data.sidebar?.order;
    if (aOrder !== undefined && bOrder !== undefined) return aOrder - bOrder;
    if (aOrder !== undefined) return -1;
    if (bOrder !== undefined) return 1;
    return a.id.localeCompare(b.id);
  });
}

/** Build a single ordered list of display entries from sidebar order. */
function buildDisplayEntries(
  sidebarOrder: ReturnType<typeof getChildOrder>,
  articles: CollectionEntry<"docs">[],
  cats: Subcategory[],
  prefix: string,
): { href: string; title: string }[] {
  const entries: { href: string; title: string }[] = [];
  const seenArticles = new Set<string>();
  const seenSubdirs = new Set<string>();

  for (const entry of sidebarOrder!) {
    if (entry.type === "article") {
      const article = articles.find((a) => {
        const rel = a.id.slice(prefix.length).replace(/\.\w+$/, "");
        return rel === entry.slug;
      });
      if (article) {
        const href = "/" + article.id.replace(/\.mdx?$/, "/");
        entries.push({ href, title: article.data.title });
        seenArticles.add(article.id);
      }
    } else if (entry.type === "subdir") {
      const cat = cats.find((c) => c.name === entry.name);
      if (cat) {
        entries.push({ href: cat.href, title: cat.title });
        seenSubdirs.add(cat.name);
      }
    }
  }

  // Any articles not in the sidebar order go after, sorted by frontmatter
  const unorderedArticles = articles.filter((a) => !seenArticles.has(a.id));
  sortArticles(unorderedArticles);
  for (const article of unorderedArticles) {
    const href = "/" + article.id.replace(/\.mdx?$/, "/");
    entries.push({ href, title: article.data.title });
  }

  // Any subcategories not in the sidebar order go after
  for (const cat of cats) {
    if (!seenSubdirs.has(cat.name)) {
      entries.push({ href: cat.href, title: cat.title });
    }
  }

  return entries;
}

let displayEntries: { href: string; title: string }[];

if (sidebarOrder) {
  displayEntries = buildDisplayEntries(
    sidebarOrder,
    filteredArticles,
    subcategories,
    prefix,
  );
} else {
  sortArticles(filteredArticles);
  displayEntries = filteredArticles.map((entry) => ({
    href: "/" + entry.id.replace(/\.mdx?$/, "/"),
    title: entry.data.title,
  }));
  displayEntries.push(
    ...subcategories.map((cat) => ({ href: cat.href, title: cat.title })),
  );
}
---

<div class="section-index-list not-content">
  {
    displayEntries.map((item) => (
      <div class="section-index-item">
        <a href={item.href}>{item.title}</a>
      </div>
    ))
  }
</div>

<style>
  .section-index-list {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .section-index-item {
    margin: 0;
  }

  .section-index-item a {
    font-family: "Open Sans", sans-serif;
    font-weight: 400;
    font-size: 1rem;
    line-height: 24px;
    color: var(--sl-oh-link-color);
    text-decoration: none;
    text-underline-offset: 2px;
  }

  .section-index-item a:hover {
    text-decoration: underline;
  }
</style>
