---
import SiteTitle from "virtual:starlight/components/SiteTitle";
import ThemeSelect from "virtual:starlight/components/ThemeSelect";
import Search from "@astrojs/starlight/components/Search.astro";

const path = Astro.url.pathname;
const isHomepage = path === "/" || path === "";
const isOncehubDevDocs =
  path.startsWith("/developers") &&
  !path.startsWith("/developers/api") &&
  !path.startsWith("/scheduleonce/");
const isOncehubDevApi = path.startsWith("/developers/api");
const isSoDevDocs =
  path.startsWith("/scheduleonce/developers") &&
  !path.startsWith("/scheduleonce/developers/api");
const isSoDevApi = path.startsWith("/scheduleonce/developers/api");

const isSoHelp =
  path.startsWith("/scheduleonce") &&
  !path.startsWith("/scheduleonce/developers");
const isOncehubHelp =
  !path.startsWith("/scheduleonce") && !path.startsWith("/developers");
---

<div class="header" class:list={{ "header--home": isHomepage }}>
  <div class="header-left">
    <SiteTitle />
  </div>

  {
    !isHomepage && (
      <div class="header-center sl-hidden md:sl-flex">
        <div class="header-search">
          <Search class="header-search-btn" />
        </div>
      </div>
    )
  }

  <div class="header-right sl-hidden md:sl-flex">
    <a
      href="https://oncehub.com/support"
      class="header-support-btn"
      target="_blank"
    >
      <svg
        width="20"
        height="20"
        viewBox="0 0 31 30"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
        aria-hidden="true"
      >
        <path
          d="M25.5035 7.37643L27.2017 7.42623H27.2105L27.4449 7.45065L27.4497 7.45162C28.9733 7.67195 30.1245 8.98088 30.1245 10.5434V21.0024L30.1177 21.226V21.2309L29.9927 21.2221L30.1167 21.2309C29.998 22.8483 28.648 24.1235 26.9995 24.1235H25.6245V27.0903L25.6158 27.2329L25.6148 27.2417C25.5375 27.8161 25.0454 28.2573 24.4497 28.2573H24.441L24.2886 28.2465L24.2788 28.2456C24.0543 28.2121 23.8427 28.1145 23.6714 27.9633L19.3335 24.1255H11.8745V22.3755H19.9947L20.0298 22.4067L23.8745 25.8071V22.3755H26.9927L27.1646 22.3647C27.846 22.2834 28.3743 21.7042 28.3745 21.0005V10.5454H28.3755L28.3658 10.3852H28.3648C28.293 9.76979 27.8196 9.24002 27.2144 9.1401L27.0904 9.12643H25.3745V7.37252L25.5035 7.37643ZM21.3033 2.8735L21.2876 2.88912C22.8792 3.03426 24.1245 4.37093 24.1245 6.00045V16.5005C24.1243 18.2268 22.7259 19.6255 20.9995 19.6255H12.2212L7.36088 24.352C7.23875 24.4707 7.08467 24.5517 6.91947 24.5835L6.90677 24.5854L6.76322 24.5981L6.7515 24.5991C6.32274 24.5991 5.96379 24.2895 5.89017 23.8813L5.88822 23.8706L5.8892 23.8696L5.87748 23.7348L5.87552 23.7241H5.8765V19.6235H4.5015C2.77496 19.6235 1.3765 18.225 1.3765 16.4985V5.9985C1.3765 4.27196 2.77496 2.8735 4.5015 2.8735H21.3033ZM20.9995 4.62448L4.49955 4.62545C3.79679 4.62568 3.21684 5.15221 3.13529 5.83151L3.12455 6.00729V16.5005C3.12477 17.2036 3.65276 17.7836 4.33255 17.8647L4.50736 17.8755H7.62552L7.62455 18.0005L7.62162 21.6557L11.4751 17.9106L11.5113 17.8755H20.9995C21.7032 17.8755 22.2841 17.3469 22.3648 16.6665L22.3755 16.5005H22.3745V6.00045C22.3745 5.29679 21.847 4.71489 21.1665 4.63424L20.9995 4.62448Z"
          fill="currentColor"
          stroke="currentColor"
          stroke-width="0.25"></path>
      </svg>
      Support
    </a>
    <!-- Nav links toggle between Developers / API Reference based on section -->
    {
      /* Outside any developer section (OnceHub help) → show "Developers" → /developers */
      isOncehubHelp && (
        <a href="/developers" class="header-nav-link">
          Developers
        </a>
      )
    }
    {
      /* Outside any developer section (ScheduleOnce help) → show "Developers" → /scheduleonce/developers */
      isSoHelp && (
        <a href="/scheduleonce/developers" class="header-nav-link">
          Developers
        </a>
      )
    }
    {
      /* On developer docs (not API) → show "API Reference" */
      isOncehubDevDocs && (
        <a href="/developers/api/" class="header-nav-link header-api-link">
          <svg
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            aria-hidden="true"
          >
            <path d="M16 18l6-6-6-6M8 6l-6 6 6 6" />
          </svg>
          API Reference
        </a>
      )
    }
    {
      /* On developer API page → show "Developers" to go back to docs */
      isOncehubDevApi && (
        <a href="/developers/overview/introduction/" class="header-nav-link">
          Developers
        </a>
      )
    }
    {
      /* ScheduleOnce developer docs (not API) → show "API Reference" */
      isSoDevDocs && (
        <a
          href="/scheduleonce/developers/api/"
          class="header-nav-link header-api-link"
        >
          <svg
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            aria-hidden="true"
          >
            <path d="M16 18l6-6-6-6M8 6l-6 6 6 6" />
          </svg>
          API Reference
        </a>
      )
    }
    {
      /* ScheduleOnce developer API page → show "Developers" to go back to docs */
      isSoDevApi && (
        <a
          href="/scheduleonce/developers/client-side-api/embedded-booking-calendar-events/"
          class="header-nav-link"
        >
          Developers
        </a>
      )
    }
    <a href="/tutorials" class="header-nav-link">Tutorials</a>
    <a href="/whats-new" class="header-nav-link">What&#8217;s New</a>
    <ThemeSelect />
  </div>
</div>

<style>
  @layer starlight.core {
    .header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      height: 100%;
      gap: 29px;
    }

    .header-left {
      flex-shrink: 0;
    }

    /* Home page: center the header items as a group, not stretched edge-to-edge */
    .header--home {
      justify-content: center;
    }
    .header--home .header-left,
    .header--home .header-right {
      flex-shrink: 0;
    }

    .header-center {
      flex: 1;
      display: flex;
      justify-content: flex-start;
    }

    .header-search {
      position: relative;
      width: 419px;
      max-width: 100%;
    }

    /* Style the Starlight search button to look like a text input */
    .header-search :global(site-search button[data-open-modal]) {
      width: 100% !important;
      height: 40px !important;
      background: #ffffff !important;
      border: 1px solid #c8c8c8 !important;
      border-radius: 0 !important;
      display: flex !important;
      align-items: center !important;
      padding: 0 16px 0 48px !important;
      color: #333333 !important;
      font-family: "Open Sans", sans-serif !important;
      font-size: 1rem !important;
      cursor: text !important;
      position: relative !important;
      gap: 8px !important;
    }
    .header-search :global(site-search button[data-open-modal]:hover) {
      border-color: #006bb1 !important;
    }
    .header-search :global(site-search kbd) {
      margin-left: auto;
      background: #f1f5f9 !important;
      border: 1px solid #e2e8f0 !important;
      font-family: inherit !important;
    }
    .header-search :global(site-search .sl-search-icon) {
      display: none !important;
    }
    /* Add search icon via pseudo-element */
    .header-search :global(site-search button[data-open-modal])::before {
      content: "";
      position: absolute;
      left: 16px;
      top: 50%;
      transform: translateY(-50%);
      width: 20px;
      height: 20px;
      background: url("data:image/svg+xml,%3Csvg viewBox='0 0 20 20' fill='none' xmlns='http://www.w3.org/2000/svg'%3E%3Ccircle cx='9' cy='9' r='7.5' stroke='%23333' stroke-width='1.5'/%3E%3Cpath d='M14 14L18.5 18.5' stroke='%23333' stroke-width='1.5' stroke-linecap='round'/%3E%3C/svg%3E")
        no-repeat center;
      background-size: contain;
    }

    .header-right {
      display: flex;
      align-items: center;
      gap: 30px;
      flex-shrink: 0;
    }

    .header-api-link {
      white-space: nowrap;
      display: inline-flex;
      align-items: center;
      gap: 6px;
    }

    @media (max-width: 49.999rem) {
      .header {
        padding: 0 16px;
      }
    }
  }
</style>
