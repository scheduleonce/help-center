---
import SiteTitle from "virtual:starlight/components/SiteTitle";
import ThemeSelect from "virtual:starlight/components/ThemeSelect";
import Search from "virtual:starlight/components/Search";
import TopicsBar from "~/components/TopicsBar.astro";
import {
  classify,
  isHomepage,
  productSwitcherLinks,
} from "~/utils/pathConditions";
import ChatbotScript from "~/components/ChatbotScript.astro";

const path = Astro.url.pathname;
const switcher = productSwitcherLinks(path);
const section = classify(path);

let botId = "BOT-DBF6132FA0";
if (section === "homepage") {
  botId = "BOT-F73E84CB6C";
} else if (section.startsWith("scheduleonce")) {
  botId = "BOT-7BD1CD075E";
}
---

<div class="header" class:list={{ "header--home": isHomepage(path) }}>
  <div class="header-left">
    {
      !isHomepage(path) && (
        <div class="product-switcher">
          <button
            class="product-switcher-btn"
            aria-label="Switch product"
            aria-expanded="false"
          >
            <svg
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              aria-hidden="true"
            >
              <rect x="3" y="3" width="7" height="7" rx="1" />
              <rect x="14" y="3" width="7" height="7" rx="1" />
              <rect x="3" y="14" width="7" height="7" rx="1" />
              <rect x="14" y="14" width="7" height="7" rx="1" />
            </svg>
          </button>
          <div class="product-switcher-dropdown" role="menu" hidden>
            <a href={switcher.oncehub} role="menuitem" class="switcher-item">
              <span class="switcher-dot" style="background: #006bb1;" />
              OnceHub
            </a>
            <a
              href={switcher.scheduleonce}
              role="menuitem"
              class="switcher-item"
            >
              <span class="switcher-dot" style="background: #7c3aed;" />
              ScheduleOnce
            </a>
          </div>
        </div>
      )
    }
    <SiteTitle />
  </div>

  {
    !isHomepage(path) ? (
      <div class="header-center sl-flex">
        <div class="header-search">
          <Search class="header-search-btn" />
        </div>
      </div>
    ) : (
      <div class="header-search-hidden-mount">
        <Search class="header-search-btn" />
      </div>
    )
  }

  <div class="header-right sl-hidden md:sl-flex">
    <a
      href="https://www.oncehub.com/live-chat-support"
      target="_blank"
      rel="noopener noreferrer"
      class="header-support-btn"
    >
      <svg
        width="20"
        height="20"
        viewBox="0 0 31 30"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
        aria-hidden="true"
      >
        <path
          d="M25.5035 7.37643L27.2017 7.42623H27.2105L27.4449 7.45065L27.4497 7.45162C28.9733 7.67195 30.1245 8.98088 30.1245 10.5434V21.0024L30.1177 21.226V21.2309L29.9927 21.2221L30.1167 21.2309C29.998 22.8483 28.648 24.1235 26.9995 24.1235H25.6245V27.0903L25.6158 27.2329L25.6148 27.2417C25.5375 27.8161 25.0454 28.2573 24.4497 28.2573H24.441L24.2886 28.2465L24.2788 28.2456C24.0543 28.2121 23.8427 28.1145 23.6714 27.9633L19.3335 24.1255H11.8745V22.3755H19.9947L20.0298 22.4067L23.8745 25.8071V22.3755H26.9927L27.1646 22.3647C27.846 22.2834 28.3743 21.7042 28.3745 21.0005V10.5454H28.3755L28.3658 10.3852H28.3648C28.293 9.76979 27.8196 9.24002 27.2144 9.1401L27.0904 9.12643H25.3745V7.37252L25.5035 7.37643ZM21.3033 2.8735L21.2876 2.88912C22.8792 3.03426 24.1245 4.37093 24.1245 6.00045V16.5005C24.1243 18.2268 22.7259 19.6255 20.9995 19.6255H12.2212L7.36088 24.352C7.23875 24.4707 7.08467 24.5517 6.91947 24.5835L6.90677 24.5854L6.76322 24.5981L6.7515 24.5991C6.32274 24.5991 5.96379 24.2895 5.89017 23.8813L5.88822 23.8706L5.8892 23.8696L5.87748 23.7348L5.87552 23.7241H5.8765V19.6235H4.5015C2.77496 19.6235 1.3765 18.225 1.3765 16.4985V5.9985C1.3765 4.27196 2.77496 2.8735 4.5015 2.8735H21.3033ZM20.9995 4.62448L4.49955 4.62545C3.79679 4.62568 3.21684 5.15221 3.13529 5.83151L3.12455 6.00729V16.5005C3.12477 17.2036 3.65276 17.7836 4.33255 17.8647L4.50736 17.8755H7.62552L7.62455 18.0005L7.62162 21.6557L11.4751 17.9106L11.5113 17.8755H20.9995C21.7032 17.8755 22.2841 17.3469 22.3648 16.6665L22.3755 16.5005H22.3745V6.00045C22.3745 5.29679 21.847 4.71489 21.1665 4.63424L20.9995 4.62448Z"
          fill="currentColor"
          stroke="currentColor"
          stroke-width="0.25"></path>
      </svg>
      Support
    </a>
    {/* Nav links */}
    <a href="/developers" class="header-nav-link">Developers</a>
    <a href="/videos" class="header-nav-link">Videos</a>
    <a href="/whats-new" class="header-nav-link">What&#8217;s New</a>
    <a href="https://oncehub.com" class="header-nav-link">Website</a>
    <a href="https://app.oncehub.com" target="_blank">Sign In</a>
    <ThemeSelect />
  </div>
</div>

<TopicsBar />
<ChatbotScript />

<style>
  @layer starlight.core {
    .header {
      display: flex;
      align-items: center;
      justify-content: space-between !important;
      height: 100%;
      gap: 29px;
    }

    .header-left {
      flex-shrink: 0;
      display: flex;
      align-items: center;
      gap: 12px;
    }

    /* Home page: center the header items as a group, not stretched edge-to-edge */
    .header--home {
      max-width: 1100px;
      margin: 0 auto;
      justify-content: center;
    }
    .header--home .header-left,
    .header--home .header-right {
      flex-shrink: 0;
    }

    .header-center {
      flex: 1;
      display: flex;
      justify-content: flex-start;
    }

    .header-search {
      position: relative;
    }

    .header-search-hidden-mount {
      display: contents;
    }
    .header-search-hidden-mount .search-trigger-btn {
      display: none !important;
    }

    @media (min-width: 50rem) {
      .header-search {
        width: 419px;
        max-width: 100%;
      }

      .header-search :global(.search-trigger-btn) {
        width: 100% !important;
        height: 40px !important;
        background: #ffffff !important;
        border: 1px solid #c8c8c8 !important;
        border-radius: 0 !important;
        display: flex !important;
        align-items: center !important;
        padding: 0 16px 0 48px !important;
        color: #333333 !important;
        font-family: "Open Sans", sans-serif !important;
        font-size: 1rem !important;
        cursor: pointer !important;
        position: relative !important;
        gap: 8px !important;
      }
      .header-search :global(.search-trigger-btn):hover {
        border-color: #006bb1 !important;
      }
      .header-search :global(.search-trigger-btn kbd) {
        margin-left: auto;
        background: #f1f5f9 !important;
        border: 1px solid #e2e8f0 !important;
        font-family: inherit !important;
      }
    }

    @media (max-width: 49.999rem) {
      .header-center {
        justify-content: flex-end;
        align-items: center;
      }

      .header-search {
        width: auto !important;
        margin-right: 4px;
      }

      .header-search :global(.search-trigger-btn) {
        width: 38px !important;
        height: 38px !important;
        padding: 0 !important;
        background: transparent !important;
        border: none !important;
        border-radius: 50% !important;
        display: flex !important;
        align-items: center !important;
        justify-content: center !important;
        color: var(--sl-color-text, #1e293b) !important;
        cursor: pointer !important;
      }

      .header-search :global(.search-trigger-btn):hover {
        background: var(--sl-color-gray-6, #f1f5f9) !important;
      }

      .header-search :global(.search-trigger-btn span),
      .header-search :global(.search-trigger-btn kbd) {
        display: none !important;
      }

      .header-search :global(.search-trigger-btn svg) {
        position: static !important;
        width: 20px !important;
        height: 20px !important;
        color: var(--sl-color-text, #1e293b) !important;
      }
    }

    .header-right {
      display: flex;
      align-items: center;
      gap: 30px;
      flex-shrink: 0;
    }

    .header-api-link {
      white-space: nowrap;
      display: inline-flex;
      align-items: center;
      gap: 6px;
    }

    /* ── Product switcher ── */
    .product-switcher {
      position: relative;
    }

    .product-switcher-btn {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 36px;
      height: 36px;
      padding: 0;
      border: 1px solid var(--sl-color-gray-5);
      border-radius: 6px;
      background: transparent;
      color: var(--sl-color-gray-2);
      cursor: pointer;
      transition:
        border-color 0.15s,
        background 0.15s;
    }

    .product-switcher-btn:hover,
    .product-switcher-btn:focus-visible {
      border-color: var(--sl-color-accent);
      background: var(--sl-color-gray-6);
    }

    .product-switcher-dropdown {
      position: absolute;
      top: calc(100% + 8px);
      left: 0;
      min-width: 180px;
      background: var(--sl-color-bg, #fff);
      border: 1px solid var(--sl-color-gray-5);
      border-radius: 8px;
      box-shadow: 0 4px 16px rgba(0, 0, 0, 0.12);
      z-index: 100;
      padding: 6px;
    }

    .product-switcher-dropdown[hidden] {
      display: none;
    }

    .switcher-item {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 8px 12px;
      border-radius: 6px;
      font-family: "Open Sans", sans-serif;
      font-size: 0.875rem;
      color: var(--sl-color-gray-2);
      text-decoration: none;
      transition: background 0.15s;
    }

    .switcher-item:hover {
      background: var(--sl-color-gray-6);
    }

    .switcher-dot {
      width: 10px;
      height: 10px;
      border-radius: 50%;
      flex-shrink: 0;
    }

    @media (max-width: 49.999rem) {
      .header {
        padding: 0 16px;
      }
    }
  }
</style>

<script>
  /**
   * Product switcher dropdown toggle.
   * Clicking the button toggles the dropdown; clicking outside closes it.
   */
  document.addEventListener("click", (event: MouseEvent) => {
    const target = event.target as HTMLElement | null;
    if (!target) return;

    const btn = target.closest(".product-switcher-btn") as HTMLElement | null;
    const dropdown = document.querySelector(
      ".product-switcher-dropdown",
    ) as HTMLElement | null;

    if (btn && dropdown) {
      event.preventDefault();
      const isOpen = !dropdown.hasAttribute("hidden");
      dropdown.toggleAttribute("hidden");
      btn.setAttribute("aria-expanded", String(!isOpen));
    } else if (dropdown && !dropdown.hasAttribute("hidden")) {
      // Click outside — close
      if (!target.closest(".product-switcher")) {
        dropdown.setAttribute("hidden", "");
        const b = document.querySelector(
          ".product-switcher-btn",
        ) as HTMLElement | null;
        if (b) b.setAttribute("aria-expanded", "false");
      }
    }
  });
</script>
