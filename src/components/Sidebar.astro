---
import MobileMenuFooter from "virtual:starlight/components/MobileMenuFooter";
import SidebarPersister from "@astrojs/starlight/components/SidebarPersister.astro";
import SidebarSublist from "@astrojs/starlight/components/SidebarSublist.astro";
import {
  classify,
  isSoHelp,
  isOncehubHelp,
  PREFIX,
} from "~/utils/pathConditions";

const { sidebar } = Astro.locals.starlightRoute;
type SidebarEntry = (typeof sidebar)[number];

const pathname = Astro.url.pathname;
const section = classify(pathname);

// Determine current section
const isDevPath =
  section === "oncehub-dev-docs" || section === "oncehub-dev-api";
const isSoDevPath =
  section === "scheduleonce-dev-docs" || section === "scheduleonce-dev-api";
const isSoPath = section === "scheduleonce-help";

function entryHasPrefix(entry: SidebarEntry, prefix: string): boolean {
  if (entry.type === "link") return entry.href.startsWith(prefix);
  if (entry.type === "group")
    return (
      entry.entries.length > 0 &&
      entry.entries.some((e: SidebarEntry) => entryHasPrefix(e, prefix))
    );
  return false;
}

function isDevEntry(entry: SidebarEntry): boolean {
  return entryHasPrefix(entry, PREFIX.developers);
}

function isSoDevEntry(entry: SidebarEntry): boolean {
  return entryHasPrefix(entry, PREFIX.scheduleonceDevelopers);
}

function isSoEntry(entry: SidebarEntry): boolean {
  return entryHasPrefix(entry, PREFIX.scheduleonce);
}

let filteredSidebar: SidebarEntry[];
if (isSoDevPath) {
  // On /scheduleonce/developers/ — show only scheduleonce-developers entries
  filteredSidebar = sidebar.filter((e) => isSoDevEntry(e));
} else if (isDevPath) {
  // On /developers/ — show only developers entries
  filteredSidebar = sidebar.filter((e) => isDevEntry(e));
} else if (isSoPath) {
  // On /scheduleonce/ (help) — show only scheduleonce-help entries
  filteredSidebar = sidebar.filter((e) => isSoEntry(e) && !isSoDevEntry(e));
} else {
  // On regular help — show only oncehub-help entries (non-scheduleonce, non-developers)
  filteredSidebar = sidebar.filter((e) => !isSoEntry(e) && !isDevEntry(e));
}

// Mobile nav link booleans
const showSoHelp = isSoHelp(pathname);
const showOncehubHelp = isOncehubHelp(pathname);
let botId = "BOT-DBF6132FA0";
if (section === "homepage") {
  botId = "BOT-F73E84CB6C";
} else if (section.startsWith("scheduleonce")) {
  botId = "BOT-7BD1CD075E";
}
---

<nav aria-label="Help Docs" class="sidebar-nav">
  <!-- Mobile-only: header nav links at top of menu -->
  <div class="mobile-header-links md:sl-hidden">
    <a href="#" data-co-bot={botId} class="mobile-header-link">
      <svg
        width="16"
        height="16"
        viewBox="0 0 31 30"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
        aria-hidden="true"
      >
        <path
          d="M25.5035 7.37643L27.2017 7.42623H27.2105L27.4449 7.45065L27.4497 7.45162C28.9733 7.67195 30.1245 8.98088 30.1245 10.5434V21.0024L30.1177 21.226V21.2309L29.9927 21.2221L30.1167 21.2309C29.998 22.8483 28.648 24.1235 26.9995 24.1235H25.6245V27.0903L25.6158 27.2329L25.6148 27.2417C25.5375 27.8161 25.0454 28.2573 24.4497 28.2573H24.441L24.2886 28.2465L24.2788 28.2456C24.0543 28.2121 23.8427 28.1145 23.6714 27.9633L19.3335 24.1255H11.8745V22.3755H19.9947L20.0298 22.4067L23.8745 25.8071V22.3755H26.9927L27.1646 22.3647C27.846 22.2834 28.3743 21.7042 28.3745 21.0005V10.5454H28.3755L28.3658 10.3852H28.3648C28.293 9.76979 27.8196 9.24002 27.2144 9.1401L27.0904 9.12643H25.3745V7.37252L25.5035 7.37643ZM21.3033 2.8735L21.2876 2.88912C22.8792 3.03426 24.1245 4.37093 24.1245 6.00045V16.5005C24.1243 18.2268 22.7259 19.6255 20.9995 19.6255H12.2212L7.36088 24.352C7.23875 24.4707 7.08467 24.5517 6.91947 24.5835L6.90677 24.5854L6.76322 24.5981L6.7515 24.5991C6.32274 24.5991 5.96379 24.2895 5.89017 23.8813L5.88822 23.8706L5.8892 23.8696L5.87748 23.7348L5.87552 23.7241H5.8765V19.6235H4.5015C2.77496 19.6235 1.3765 18.225 1.3765 16.4985V5.9985C1.3765 4.27196 2.77496 2.8735 4.5015 2.8735H21.3033ZM20.9995 4.62448L4.49955 4.62545C3.79679 4.62568 3.21684 5.15221 3.13529 5.83151L3.12455 6.00729V16.5005C3.12477 17.2036 3.65276 17.7836 4.33255 17.8647L4.50736 17.8755H7.62552L7.62455 18.0005L7.62162 21.6557L11.4751 17.9106L11.5113 17.8755H20.9995C21.7032 17.8755 22.2841 17.3469 22.3648 16.6665L22.3755 16.5005H22.3745V6.00045C22.3745 5.29679 21.847 4.71489 21.1665 4.63424L20.9995 4.62448Z"
          fill="currentColor"
          stroke="currentColor"
          stroke-width="0.25"></path>
      </svg>
      Support
    </a>
    <!-- Mobile nav links — only show when outside dev paths (TopicsBar handles dev) -->
    {
      showOncehubHelp && (
        <a href="/developers/overview/introduction/" class="mobile-header-link">
          Developers
        </a>
      )
    }
    {
      showSoHelp && (
        <a href="/scheduleonce/developers" class="mobile-header-link">
          Developers
        </a>
      )
    }
    <a
      href="https://www.youtube.com/playlist?list=PLbDqoI6OzOkkaEHwtL-GcZZl573tDbtMc"
      class="mobile-header-link">Videos</a
    >
    <a href="/whats-new" class="mobile-header-link">What&#8217;s New</a>
  </div>

  <div class="sidebar-divider md:sl-hidden"></div>

  <SidebarPersister>
    <SidebarSublist sublist={filteredSidebar} />
  </SidebarPersister>
</nav>

<script>
  (() => {
    // After Starlight restores sidebar scroll position, check if the active
    // page link is visible. If not, scroll it into view so the user can see
    // where they are in the navigation tree.
    const scroller = document.getElementById("starlight__sidebar");
    const activeLink = scroller?.querySelector('[aria-current="page"]');
    if (scroller && activeLink) {
      // Use a microtask to run after the SidebarPersister restores scroll
      queueMicrotask(() => {
        const containerRect = scroller.getBoundingClientRect();
        const linkRect = activeLink.getBoundingClientRect();
        const isVisible =
          linkRect.top >= containerRect.top &&
          linkRect.bottom <= containerRect.bottom;
        if (!isVisible) {
          activeLink.scrollIntoView({ block: "center", behavior: "auto" });
        }
      });
    }
  })();
</script>

<div class="md:sl-hidden">
  <MobileMenuFooter />
</div>

<style>
  @layer starlight.core {
    .sidebar-nav {
      display: flex;
      flex-direction: column;
      gap: 16px;
    }

    .mobile-header-links {
      display: flex;
      flex-direction: column;
      gap: 4px;
      padding: 0 12px;
    }

    .mobile-header-link {
      display: flex;
      align-items: center;
      gap: 8px;
      padding: 8px 0;
      font-family: "Open Sans", sans-serif;
      font-size: 0.875rem;
      font-weight: 400;
      line-height: 22px;
      color: #333333;
      text-decoration: none;
      border-radius: 8px;
      transition: background 0.15s;
    }
    .mobile-header-link:hover {
      color: #006bb1;
    }

    .sidebar-divider {
      height: 1px;
      background: #e5e7eb;
      margin: 0 12px;
    }
  }
</style>
