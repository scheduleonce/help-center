---
import MobileMenuFooter from "virtual:starlight/components/MobileMenuFooter";
import SidebarPersister from "@astrojs/starlight/components/SidebarPersister.astro";
import SidebarList from "./SidebarList.astro";

const { sidebar } = Astro.locals.starlightRoute;
type SidebarEntry = (typeof sidebar)[number];

const SO_PREFIXES = ["/scheduleonce/"];
const isScheduleOnce = SO_PREFIXES.some((p) =>
  Astro.url.pathname.startsWith(p),
);

function isSoEntry(entry: SidebarEntry): boolean {
  if (entry.type === "link")
    return SO_PREFIXES.some((p) => entry.href.startsWith(p));
  if (entry.type === "group")
    return (
      entry.entries.length > 0 &&
      entry.entries.some((e: SidebarEntry) => isSoEntry(e))
    );
  return false;
}

const filteredSidebar = sidebar.filter(
  (entry: SidebarEntry) => isSoEntry(entry) === isScheduleOnce,
);
---

<nav aria-label="Help Docs" class="sidebar-nav">
  <h3 class="sidebar-helpdocs-heading">HELP DOCS</h3>
  <SidebarPersister>
    <SidebarList sublist={filteredSidebar} />
  </SidebarPersister>
</nav>

<div class="md:sl-hidden">
  <MobileMenuFooter />
</div>

<style>
  @layer starlight.core {
    .sidebar-nav {
      display: flex;
      flex-direction: column;
      gap: 16px;
    }
  }
</style>
