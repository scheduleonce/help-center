---
import Default from "@astrojs/starlight/components/Footer.astro";
import { isHomepage, isScheduleOnce } from "~/utils/pathConditions";
import { Icon } from "@astrojs/starlight/components";
const path = Astro.url.pathname;

const videosUrl = isScheduleOnce(path)
  ? "https://www.youtube.com/playlist?list=PLbDqoI6OzOknyfsIKOZR28-54myL9QnN8"
  : "https://www.youtube.com/playlist?list=PLbDqoI6OzOkkqqnzbvjgt-qVMZV8ksmU4";

const social = [
  { icon: "linkedin", href: "https://www.linkedin.com/company/2277459" },
  { icon: "youtube", href: videosUrl },
];

const groups = {
  "How to Contact Us": [
    {
      text: "Live Chat",
      href: "https://www.oncehub.com/live-chat-support",
      target: "_blank",
    },
    {
      text: "Email Support",
      href: "mailto:support@oncehub.com",
      target: "_self",
    },
    {
      text: "System Status",
      href: "https://status.oncehub.com/",
      target: "_blank",
    },
  ],
  Resources: [
    {
      text: "Videos",
      href: videosUrl,
      target: "_blank",
    },
    { text: "Blog", href: "https://www.oncehub.com/blog", target: "_blank" },
    { text: "Website", href: "https://oncehub.com", target: "_blank" },
    ...(isScheduleOnce(path)
      ? [
          {
            text: "ScheduleOnce v1 (Deprecated)",
            href: "/scheduleonce/developers/v1/",
            target: "_self",
          },
        ]
      : []),
  ],
};

const year = new Date().getFullYear();
---

{
  /* Render the default Starlight footer (pagination, last modified) — skip on home page where pagination is empty */
}
{
  !isHomepage(path) && (
    <Default>
      <slot />
    </Default>
  )
}

{/* Site-wide footer anchored to the content column */}
<footer class={`site-footer${isHomepage(path) ? " site-footer--home" : ""}`}>
  <div class="footer-container">
    <div class="footer-grid">
      {
        Object.entries(groups).map(([title, items]) => (
          <ul class="footer-column">
            <li class="footer-title">
              <strong>{title}</strong>
            </li>
            {items.map((link) => (
              <li>
                <a
                  target={link.target}
                  rel="noopener noreferrer"
                  href={link.href}
                >
                  {link.text}
                </a>
              </li>
            ))}
          </ul>
        ))
      }
    </div>
  </div>
  <div class="footer-legal">
    <div class="footer-legal-container">
      <div class="footer-legal-links-container">
        <div class="footer-legal-links">
          <a href="/"
            ><img src="/assets/OH.svg" alt="OnceHub Logo" width="20" /></a
          >
          <a
            href="https://www.oncehub.com/trustcenter/legal/privacynotice"
            class="demo-link">Privacy Notice</a
          >
          <span class="legal-divider">|</span>
          <a
            href="https://www.oncehub.com/trustcenter/legal/cookienotice/"
            class="demo-link">Cookie Notice</a
          >
        </div>
        <div class="footer-social-links">
          {
            social.map(({ icon, href }) => (
              <ul class="social-links">
                <li>
                  <a href={href}>
                    <Icon name={icon} class={`icon ${icon}`} />
                  </a>
                </li>
              </ul>
            ))
          }
        </div>
      </div>
      <div class="copyright">
        &copy; Copyright {year} OnceHub. All rights reserved.
      </div>
    </div>
  </div>

  <style>
    .site-footer--home {
      margin-top: 0;
    }

    .site-footer {
      font-family: "Open Sans", sans-serif;
      width: calc(100% + 2 * var(--sl-content-pad-x));
      background: var(--sl-footer-bg);
      margin-top: 0;
      margin-inline: calc(-1 * var(--sl-content-pad-x, 1.5rem));
      padding-inline: var(--sl-content-pad-x, 1.5rem);
    }

    .footer-container {
      max-width: 1100px;
      margin: 0 auto;
      padding: 3rem 0rem 1rem;
    }

    .footer-grid {
      display: flex;
      margin-bottom: 0rem;
      gap: 7.5rem;
    }

    .footer-column {
      list-style: none;
      padding: 0;
      margin: 0;
    }

    .footer-column .footer-title {
      font-size: 1rem;
      line-height: 1.5rem;
      font-weight: 600;
      color: var(--sl-color-accent);
      margin-bottom: 0.625rem;
    }
    .footer-column li {
      margin-bottom: 0.5rem;
      font-size: 1rem;
      line-height: 1.5rem;
    }

    .footer-column a {
      color: var(--sl-color-accent);
      text-decoration: none;
      transition: color 0.2s;
    }

    .footer-column a:hover {
      color: var(--sl-color-gray-1);
    }

    .footer-legal {
      display: flex;
      max-width: 1100px;
      margin: 0 auto;
      gap: 0.5rem;
      font-size: 1rem;
      line-height: 1.5rem;
      color: var(--sl-color-accent);
      padding: 1.5rem 0 3.75rem;
    }
    .footer-legal-container {
      width: 100%;
      margin: 0 auto;
    }
    .footer-legal-links-container {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 1.25rem;
    }
    .footer-legal-links {
      display: flex;
      align-items: center;
      gap: 1rem;
    }
    .footer-social-links {
      display: flex;
      align-items: center;
      gap: 1.25rem;
    }
    .legal-divider {
      color: var(--sl-color-accent);
    }

    .demo-link {
      color: var(--sl-color-accent);
      text-decoration: none;
    }

    .demo-link:hover {
      text-decoration: underline;
    }
    .footer-social-links .social-links li {
      display: inline-flex;
      gap: 0.5rem;
      list-style: none;
    }
    .footer-social-links .social-links li a {
      display: inline-flex;
      justify-content: center;
      align-items: center;
      padding: 4px;
      border-radius: 100%;
      border: 1px solid var(--sl-color-accent);
    }
  </style>
</footer>
