---
import Default from "@astrojs/starlight/components/Footer.astro";
import { isHomepage } from "~/utils/pathConditions";

const path = Astro.url.pathname;

const groups = {
  Resources: [
    { text: "API", href: "/api/" },
    { text: "Tutorials", href: "/tutorials" },
    { text: "OnceHub MCP", href: "/developers" },
    { text: "What's New", href: "/whats-new" },
    {
      text: "Developer documentation",
      href: "https://developers.oncehub.com/",
    },
  ],
  Support: [
    { text: "System status", href: "https://status.oncehub.com/" },
    { text: "Book a live demo", href: "https://go.oncehub.com/OnceHub-Demo" },
    { text: "Training videos", href: "/tutorials" },
  ],
  Company: [
    { text: "oncehub.com", href: "https://www.oncehub.com/" },
    { text: "Careers", href: "https://www.oncehub.com/careers" },
    {
      text: "Terms of Use",
      href: "https://www.oncehub.com/trustcenter/legal/terms",
    },
    {
      text: "Privacy Policy",
      href: "https://www.oncehub.com/trustcenter/legal/privacynotice",
    },
  ],
  Contacts: [
    { text: "Sales", href: "https://www.oncehub.com/contact" },
    {
      text: "Customer Support",
      href: "https://www.oncehub.com/live-chat-support",
    },
    { text: "Sign up for free", href: "https://www.oncehub.com/signup" },
  ],
};

const year = new Date().getFullYear();
---

{
  /* Render the default Starlight footer (pagination, last modified) — skip on home page where pagination is empty */
}
{
  !isHomepage && (
    <Default>
      <slot />
    </Default>
  )
}

{/* Site-wide footer anchored to the content column */}
<footer class={`site-footer${isHomepage ? " site-footer--home" : ""}`}>
  <div class="footer-container">
    <div class="footer-grid">
      {
        Object.entries(groups).map(([title, items]) => (
          <ul class="footer-column">
            <li class="footer-title">
              <strong>{title}</strong>
            </li>
            {items.map((link) => (
              <li>
                <a href={link.href}>{link.text}</a>
              </li>
            ))}
          </ul>
        ))
      }
    </div>
  </div>
  <div class="footer-legal">
    <div class="footer-legal-container">
      <span class="copyright"
        >&copy; Copyright {year} OnceHub. All rights reserved.</span
      >
      <span class="legal-divider">|</span>
      <a
        href="https://www.oncehub.com/trustcenter/legal/privacynotice"
        class="demo-link">Privacy Notice</a
      >
      <span class="legal-divider">|</span>
      <a
        href="https://www.oncehub.com/trustcenter/legal/cookienotice/"
        class="demo-link">Cookie Notice</a
      >
    </div>
  </div>
</footer>

<style>
  .site-footer--home {
    margin-top: 0;
  }

  .site-footer {
    width: calc(100% + 2 * var(--sl-content-pad-x));
    border-top: 1px solid var(--sl-color-gray-5);
    background-color: #eef6ff;
    margin-inline: calc(-1 * var(--sl-content-pad-x, 1.5rem));
    padding-inline: var(--sl-content-pad-x, 1.5rem);
  }

  .footer-container {
    max-width: 1100px;
    margin: 0 auto;
    padding: 3rem 1.5rem 2rem;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 2rem;
    margin-bottom: 3rem;
  }

  .footer-column {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .footer-title {
    font-size: 0.875rem;
    color: var(--sl-color-gray-2);
    margin-bottom: 1rem;
  }

  .footer-column li {
    margin-bottom: 0.5rem;
    font-size: 0.875rem;
  }

  .footer-column a {
    color: var(--sl-color-gray-3);
    text-decoration: none;
    transition: color 0.2s;
  }

  .footer-column a:hover {
    color: var(--sl-color-gray-1);
  }

  .footer-legal {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: 0.5rem;
    font-size: 0.75rem;
    color: var(--sl-color-gray-3);
    width: calc(100% + 2 * var(--sl-content-pad-x));
    border-top: 1px solid var(--sl-color-gray-5);
    background-color: #eef6ff;
    margin-inline: calc(-1 * var(--sl-content-pad-x, 1.5rem));
    padding: 1.5rem 0;
  }
  .footer-legal-container {
    max-width: 1100px;
    margin: 0 auto;
  }
  .legal-divider {
    color: var(--sl-color-gray-5);
  }

  .demo-link {
    color: var(--sl-color-gray-3);
    text-decoration: none;
  }

  .demo-link:hover {
    text-decoration: underline;
  }
</style>
