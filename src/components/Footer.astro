---
import Default from "@astrojs/starlight/components/Footer.astro";
import EditLink from "@astrojs/starlight/components/EditLink.astro";
import Pagination from "@astrojs/starlight/components/Pagination.astro";

const groups = {
  Resources: [
    { text: "API", href: "/api/" },
    { text: "Directory", href: "/directory/" },
    { text: "Open Source", href: "https://github.com/oncehub" },
  ],
  Support: [
    { text: "Help Center", href: "https://help.oncehub.com/" },
    { text: "System Status", href: "https://status.oncehub.com/" },
  ],
  Company: [
    { text: "oncehub.com", href: "https://www.oncehub.com/" },
    { text: "Careers", href: "https://www.oncehub.com/careers" },
  ],
};

const legal = {
  "Privacy Policy": "https://www.oncehub.com/privacy",
  "Terms of Use": "https://www.oncehub.com/terms",
};

const year = new Date().getFullYear();
---

{
  /* Render the default Starlight footer (pagination, last modified, edit link) */
}
<Default><slot /></Default>

{/* Site-wide footer anchored to the content column */}
<footer class="site-footer">
  <div class="footer-container">
    <div class="footer-grid">
      {
        Object.entries(groups).map(([title, items]) => (
          <ul class="footer-column">
            <li class="footer-title">
              <strong>{title}</strong>
            </li>
            {items.map((link) => (
              <li>
                <a href={link.href}>{link.text}</a>
              </li>
            ))}
          </ul>
        ))
      }
    </div>

    <div class="footer-legal">
      <span class="copyright">&copy; {year} OnceHub Ltd.</span>
      <ul class="legal-links">
        {
          Object.entries(legal).map(([text, href]) => (
            <li>
              <a href={href}>{text}</a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    width: 100%;
    border-top: 1px solid var(--sl-color-gray-5);
    background-color: var(--sl-color-bg);
  }

  .footer-container {
    max-width: var(--sl-content-width);
    margin: 0 auto;
    padding: 3rem 1.5rem 2rem;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: 2rem;
    margin-bottom: 3rem;
  }

  .footer-column {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .footer-title {
    font-size: 0.875rem;
    color: var(--sl-color-gray-2);
    margin-bottom: 1rem;
  }

  .footer-column li {
    margin-bottom: 0.5rem;
    font-size: 0.875rem;
  }

  .footer-column a {
    color: var(--sl-color-gray-3);
    text-decoration: none;
    transition: color 0.2s;
  }

  .footer-column a:hover {
    color: var(--sl-color-gray-1);
  }

  .footer-legal {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.5rem;
    font-size: 0.75rem;
    color: var(--sl-color-gray-3);
    border-top: 1px solid var(--sl-color-gray-5);
    padding-top: 1.5rem;
  }

  .legal-links {
    display: flex;
    list-style: none;
    padding: 0;
    margin: 0;
    gap: 1.5rem;
    flex-wrap: wrap;
  }

  .legal-links a {
    color: inherit;
    text-decoration: none;
  }

  .legal-links a:hover {
    text-decoration: underline;
  }
</style>
