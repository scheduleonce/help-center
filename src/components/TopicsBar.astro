---
import { classify, isHomepage, topicsBarLinks } from "~/utils/pathConditions";

const path = Astro.url.pathname;
const section = classify(path);

const links = topicsBarLinks(path);

// Determine which topic is active
const isUserGuidesActive =
  section === "oncehub-help" || section === "scheduleonce-help";
const isDocsActive =
  section === "oncehub-dev-docs" || section === "scheduleonce-dev-docs";
const isApiActive =
  section === "oncehub-dev-api" || section === "scheduleonce-dev-api";
---

{
  !isHomepage(path) && (
    <nav class="topics-bar not-content" aria-label="Main topics">
      <div class="topics-bar-inner">
        <a
          href={links.userGuides}
          class:list={[
            "topic-link",
            { "topic-link--active": isUserGuidesActive },
          ]}
        >
          <svg
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            aria-hidden="true"
          >
            <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20" />
            <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z" />
          </svg>
          User Guides
        </a>
        <a
          href={links.docs}
          class:list={["topic-link", { "topic-link--active": isDocsActive }]}
        >
          <svg
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            aria-hidden="true"
          >
            <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20" />
            <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z" />
          </svg>
          Dev Docs
        </a>
        <a
          href={links.api}
          class:list={["topic-link", { "topic-link--active": isApiActive }]}
        >
          <svg
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            aria-hidden="true"
          >
            <path d="M16 18l6-6-6-6M8 6l-6 6 6 6" />
          </svg>
          API Reference
        </a>
      </div>
    </nav>
  )
}

<style>
  .topics-bar {
    width: 100%;
    border-bottom: 1px solid var(--sl-color-hairline-light, #e5e7eb);
    background: var(--sl-color-bg-nav, var(--sl-color-bg, #fff));
  }

  .topics-bar-inner {
    display: flex;
    align-items: center;
    gap: 0;
    max-width: var(--sl-content-width, 90rem);
    margin: 0 auto;
    padding: 0 var(--sl-content-pad-x, 1.5rem);
  }

  .topic-link {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 10px 20px;
    font-family: "Open Sans", sans-serif;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--sl-color-gray-3, #6b7280);
    text-decoration: none;
    border-bottom: 2px solid transparent;
    transition:
      color 0.15s,
      border-color 0.15s;
    white-space: nowrap;
  }

  .topic-link:hover {
    color: var(--sl-color-text-accent, #006bb1);
  }

  .topic-link--active {
    color: var(--sl-color-text-accent, #006bb1);
    border-bottom-color: var(--sl-color-text-accent, #006bb1);
  }

  .topic-link svg {
    flex-shrink: 0;
  }
</style>
