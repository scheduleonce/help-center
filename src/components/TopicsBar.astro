---
import {
  classify,
  isHomepage,
  isScheduleOnceV1,
  topicsBarLinks,
} from "~/utils/pathConditions";

const path = Astro.url.pathname;
const section = classify(path);

const links = topicsBarLinks(path);

// Determine which topic is active
const isUserGuidesActive =
  section === "oncehub-help" || section === "scheduleonce-help";
const isDocsActive =
  section === "oncehub-dev-docs" || section === "scheduleonce-dev-docs";
const isApiActive =
  section === "oncehub-dev-api" || section === "scheduleonce-dev-api";
---

{
  !isHomepage(path) && !isScheduleOnceV1(path) && (
    <nav class="topics-bar not-content" aria-label="Main topics">
      <div class="topics-bar-inner">
        <a
          href={links.userGuides}
          class:list={[
            "topic-link",
            { "topic-link--active": isUserGuidesActive },
          ]}
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="20"
            height="20"
            viewBox="0 0 20 20"
            fill="none"
          >
            <path
              d="M16.3032 1.89844H5.0277C4.29508 1.89844 3.70117 2.52923 3.70117 3.30736M3.70117 3.30736C3.70117 4.08549 4.29508 4.71629 5.0277 4.71629H15.64C16.0063 4.71629 16.3032 5.03169 16.3032 5.42075V17.3966C16.3032 17.7857 16.0063 18.1011 15.64 18.1011H5.0277C4.29508 18.1011 3.70117 17.4703 3.70117 16.6921V3.30736Z"
              stroke="currentColor"
              stroke-width="1.2"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
          User Guides
        </a>
        <a
          href={links.docs}
          class:list={["topic-link", { "topic-link--active": isDocsActive }]}
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="20"
            height="20"
            viewBox="0 0 20 20"
            fill="none"
          >
            <path
              d="M15 13.3385L18.3333 10.0052L15 6.67188"
              stroke="currentColor"
              stroke-width="1.2"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
            <path
              d="M4.99965 6.67188L1.66632 10.0052L4.99965 13.3385"
              stroke="currentColor"
              stroke-width="1.2"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
            <path
              d="M12.083 3.32812L7.91632 16.6615"
              stroke="currentColor"
              stroke-width="1.2"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
          Dev Docs
        </a>
        <a
          href={links.api}
          class:list={["topic-link", { "topic-link--active": isApiActive }]}
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="20"
            height="20"
            viewBox="0 0 20 20"
            fill="none"
          >
            <g clip-path="url(#clip0_2247_2763)">
              <path
                d="M12.041 0C12.478 0 12.855 0.294 12.955 0.701L12.974 0.805L13.294 3.042L13.341 3.063C13.637 3.201 13.923 3.358 14.201 3.537L14.476 3.722L14.523 3.757L16.642 2.907C17.001 2.776 17.408 2.873 17.661 3.142L17.732 3.228L17.793 3.324L19.685 6.598C19.889 6.973 19.826 7.432 19.533 7.728L19.447 7.805L17.666 9.197L17.688 9.443L17.696 9.562L17.701 9.679L17.705 9.911L17.701 10.143L17.688 10.379L17.666 10.624L19.449 12.018C19.749 12.255 19.866 12.643 19.77 13.007L19.73 13.127L19.68 13.233L17.799 16.487C17.59 16.87 17.154 17.051 16.74 16.945L16.628 16.909L14.522 16.063L14.464 16.105C14.186 16.298 13.905 16.47 13.62 16.619L13.296 16.777L12.976 19.007C12.927 19.403 12.63 19.711 12.254 19.796L12.149 19.814L12.041 19.82H8.268C7.831 19.82 7.454 19.526 7.354 19.119L7.335 19.015L7.014 16.777L6.968 16.757C6.672 16.62 6.386 16.462 6.108 16.283L5.833 16.098L5.785 16.062L3.668 16.912C3.309 17.043 2.902 16.946 2.649 16.677L2.578 16.591L2.517 16.495L0.625 13.221C0.421 12.846 0.484 12.387 0.777 12.091L0.863 12.014L2.644 10.621L2.623 10.377L2.61 10.139L2.606 9.909L2.61 9.679L2.623 9.441L2.644 9.196L0.862 7.802C0.555 7.56 0.433 7.16 0.54 6.798L0.579 6.691L0.632 6.587L2.513 3.333C2.722 2.95 3.158 2.769 3.572 2.875L3.684 2.911L5.789 3.756L5.847 3.715C6.125 3.522 6.406 3.35 6.691 3.201L6.978 3.059L7.015 3.043L7.335 0.814C7.384 0.418 7.681 0.11 8.057 0.025L8.162 0.007L8.27 0.001H12.043L12.041 0ZM12.033 0.951H8.274L7.879 3.709L7.627 3.812C7.223 3.978 6.828 4.195 6.433 4.465L6.137 4.677L5.923 4.838L3.338 3.8L1.454 7.06L3.65 8.776L3.617 9.044C3.576 9.374 3.555 9.65 3.555 9.909C3.555 10.103 3.567 10.307 3.59 10.536L3.617 10.774L3.65 11.042L1.454 12.759L3.338 16.018L5.926 14.98L6.141 15.146C6.515 15.434 6.905 15.675 7.315 15.87L7.626 16.008L7.878 16.111L8.273 18.867H12.032L12.428 16.111L12.68 16.008C13.084 15.842 13.479 15.625 13.874 15.355L14.17 15.143L14.384 14.982L16.968 16.019L18.853 12.762L16.657 11.044L16.69 10.776C16.732 10.439 16.752 10.176 16.752 9.911C16.752 9.699 16.739 9.488 16.712 9.239L16.656 8.777L18.851 7.06L16.967 3.801L14.38 4.84L14.165 4.674C13.791 4.386 13.401 4.145 12.991 3.95L12.68 3.812L12.428 3.709L12.032 0.951H12.033Z"
                fill="currentColor"
              />
              <path
                d="M8.41681 12L7.99786 10.8105H6.36017L5.94122 12H5.20001L6.79376 7.69922H7.57306L9.16388 12H8.41681ZM7.81622 10.207L7.409 9.03516C7.39337 8.98438 7.37091 8.91309 7.34161 8.82129C7.31232 8.72754 7.28302 8.63281 7.25372 8.53711C7.22443 8.43945 7.20001 8.35742 7.18048 8.29102C7.16095 8.37109 7.13654 8.46094 7.10724 8.56055C7.0799 8.6582 7.05255 8.75 7.02521 8.83594C6.99982 8.92188 6.98029 8.98828 6.96661 9.03516L6.55646 10.207H7.81622ZM10.9744 7.7168C11.5272 7.7168 11.9305 7.83008 12.1844 8.05664C12.4383 8.2832 12.5652 8.60059 12.5652 9.00879C12.5652 9.19434 12.5359 9.37109 12.4774 9.53906C12.4207 9.70508 12.327 9.85254 12.1961 9.98145C12.0652 10.1084 11.8924 10.209 11.6776 10.2832C11.4647 10.3574 11.202 10.3945 10.8895 10.3945H10.4324V12H9.72931V7.7168H10.9744ZM10.9276 8.2998H10.4324V9.80859H10.8162C11.0369 9.80859 11.2244 9.7832 11.3787 9.73242C11.533 9.67969 11.6502 9.59668 11.7303 9.4834C11.8104 9.37012 11.8504 9.2207 11.8504 9.03516C11.8504 8.78711 11.7752 8.60254 11.6248 8.48145C11.4764 8.36035 11.244 8.2998 10.9276 8.2998ZM13.4207 12V7.7168H14.1238V12H13.4207Z"
                fill="currentColor"
              />
            </g>
            <defs>
              <clipPath id="clip0_2247_2763">
                <rect width="20" height="20" fill="white" />
              </clipPath>
            </defs>
          </svg>
          API Reference
        </a>
      </div>
    </nav>
  )
}

<style>
  .topics-bar {
    width: 100%;
    border-bottom: none;
    /* border-bottom: 1px solid var(--sl-color-hairline-light, #e5e7eb);
    background: var(--sl-color-bg-nav, var(--sl-color-bg, #ddecfc)); */
  }

  .topics-bar-inner {
    display: flex;
    align-items: center;
    gap: 0;
    max-width: var(--sl-content-width, 90rem);
    margin: 0 auto;
    padding: 0 var(--sl-content-pad-x, 1.5rem);
  }

  .topic-link {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 13px 15px;
    font-family: "Open Sans", sans-serif;
    font-size: 0.875rem;
    font-weight: 400;
    line-height: 1.375rem;
    color: var(--sl-tabs-color);
    text-transform: uppercase;
    text-decoration: none;
    border-bottom: 2px solid transparent;
    transition:
      color 0.15s,
      border-color 0.15s;
    white-space: nowrap;
  }

  .topic-link:hover {
    background: var(--sl-tabs-hover-bg);
    color: var(--sl-tabs-color);
  }

  .topic-link--active {
    color: var(--sl-tabs-color);
    border-bottom-color: var(--sl-tabs-active-hairline);
    background: var(--sl-tabs-active-bg);
  }
  .topic-link--active:hover {
    background: var(--sl-tabs-active-bg);
  }

  .topic-link svg {
    flex-shrink: 0;
  }
</style>
