                fill="currentColor"
              />
              <path
                d="M13.7129 12.002V7.71875H14.876V12.002H13.7129Z"
                fill="currentColor"
              />
              <path
                d="M11.1055 7.71875C11.6484 7.71875 12.0547 7.83691 12.3242 8.07324C12.5957 8.30957 12.7314 8.64551 12.7314 9.08105C12.7314 9.27637 12.7031 9.46387 12.6465 9.64355C12.5918 9.82324 12.501 9.9834 12.374 10.124C12.249 10.2646 12.082 10.376 11.873 10.458C11.666 10.54 11.4102 10.5811 11.1055 10.5811H10.7803V12.002H9.62305V7.71875H11.1055ZM11.0791 8.65332H10.7803V9.6377H11.0088C11.1084 9.6377 11.2012 9.62109 11.2871 9.58789C11.373 9.55273 11.4414 9.49707 11.4922 9.4209C11.5449 9.34277 11.5713 9.23926 11.5713 9.11035C11.5713 8.97559 11.5312 8.86621 11.4512 8.78223C11.3711 8.69629 11.2471 8.65332 11.0791 8.65332Z"
                fill="currentColor"
              />
              <path
                d="M7.59082 12.0039L7.37988 11.2012H5.98828L5.77148 12.0039H4.5L5.89746 7.70312H7.44141L8.85645 12.0039H7.59082ZM7.13965 10.252L6.95508 9.54883C6.93555 9.47266 6.90723 9.36426 6.87012 9.22363C6.83301 9.08105 6.7959 8.93457 6.75879 8.78418C6.72363 8.63184 6.69629 8.50684 6.67676 8.40918C6.65918 8.50684 6.63379 8.62793 6.60059 8.77246C6.56934 8.91504 6.53613 9.05664 6.50098 9.19727C6.46777 9.33789 6.43848 9.45508 6.41309 9.54883L6.22852 10.252H7.13965Z"
                fill="currentColor"
              />
            </g>
            <defs>
              <clipPath id="clip0_2062_11798">
                <rect width="20" height="20" fill="white" />
              </clipPath>
            </defs>
          </svg>
          API Reference
        </a>
      </div>
    </nav>
  )
}

<style>
  .topics-bar {
    width: 100%;
    border-bottom: none;
    /* border-bottom: 1px solid var(--sl-color-hairline-light, #e5e7eb);
    background: var(--sl-color-bg-nav, var(--sl-color-bg, #ddecfc)); */
  }

  .topics-bar-inner {
    display: flex;
    align-items: center;
    gap: 0;
    max-width: var(--sl-content-width, 90rem);
    margin: 0 auto;
    padding: 0 var(--sl-content-pad-x, 1.5rem);
  }

  .topic-link {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 13px 15px;
    font-family: "Open Sans", sans-serif;
    font-size: 0.875rem;
    font-weight: 400;
    line-height: 1.375rem;
    color: var(--sl-tabs-color);
    text-transform: uppercase;
    text-decoration: none;
    border-bottom: 2px solid transparent;
    transition:
      color 0.15s,
      border-color 0.15s;
    white-space: nowrap;
  }

  .topic-link:hover {
    background: var(--sl-tabs-hover-bg);
    color: var(--sl-tabs-color);
  }

  .topic-link--active {
    color: var(--sl-tabs-color);
    border-bottom-color: var(--sl-tabs-active-hairline);
    background: var(--sl-tabs-active-bg);
  }
  .topic-link--active:hover {
    background: var(--sl-tabs-active-bg);
  }

  .topic-link svg {
    flex-shrink: 0;
  }
</style>
