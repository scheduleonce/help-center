---
import fs from "node:fs";
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
import { ScalarComponent } from "@scalar/astro";
import "@scalar/api-reference/style.css";

interface Props {
  /** URL path to the OpenAPI YAML spec (e.g. "/developers/api/booking-calendars-api.yaml") */
  specUrl: string;
  /** Page title (also used as Scalar metaData.title) */
  title: string;
  /** Absolute path to the pre-generated HTML snippet for Pagefind indexing */
  apiHtmlPath: string;
}

const { specUrl, title, apiHtmlPath } = Astro.props;

const hiddenApiHtml = fs.existsSync(apiHtmlPath)
  ? fs.readFileSync(apiHtmlPath, "utf8")
  : "";
---

<StarlightPage
  frontmatter={{
    title,
    tableOfContents: false,
    template: "splash",
  }}
  hasSidebar={false}
>
  <!-- Hidden API content for crawlers and search indexing (Pagefind) -->
  {
    hiddenApiHtml ? (
      <div
        class="hidden-api-content"
        style="display: none;"
        set:html={hiddenApiHtml}
      />
    ) : null
  }

  <ScalarComponent
    renderMode="client"
    configuration={{
      url: specUrl,
      cdn: "/scalar/standalone.js",
      metaData: { title },
      documentDownloadType: "direct",
      hideDarkModeToggle: true,
      hideModels: true,
      showDeveloperTools: "never",
      theme: "none",
      _integration: "astro",
    }}
  />
</StarlightPage>

<style is:global>
  /* ═══════════════════════════════════════════════════════════════
     SCALAR THEME — map Starlight colour tokens to Scalar variables
     ═══════════════════════════════════════════════════════════════ */
  :root,
  body,
  .scalar-api-reference,
  scalar-api-reference {
    /* Text */
    --scalar-color-1: var(--sl-color-white);
    --scalar-color-2: var(--sl-color-gray-2);
    --scalar-color-3: var(--sl-color-gray-3);
    --scalar-color-accent: var(--sl-color-accent);
    --scalar-color-disabled: var(--sl-color-gray-4);

    /* Backgrounds */
    --scalar-background-1: var(--sl-color-bg);
    --scalar-background-2: var(--sl-color-gray-6);
    --scalar-background-3: var(--sl-color-gray-6);
    --scalar-background-4: var(--sl-color-gray-6);
    --scalar-background-accent: var(--sl-color-accent-low);

    /* Borders */
    --scalar-border-color: var(--sl-color-gray-5);

    /* Buttons */
    --scalar-button-1: var(--sl-color-accent);
    --scalar-button-1-color: #ffffff;
    --scalar-button-1-hover: var(--sl-color-accent-high);

    /* Sidebar */
    --scalar-sidebar-color-1: var(--sl-color-gray-2);
    --scalar-sidebar-color-2: var(--sl-color-gray-3);
    --scalar-sidebar-border-color: var(--sl-color-gray-5);
    --scalar-sidebar-background-1: var(--sl-color-bg-sidebar);
    --scalar-sidebar-item-active-background: var(--sl-color-gray-6);

    /* Header */
    --scalar-header-background-1: var(--sl-color-bg-nav);

    /* Links */
    --scalar-link-color: var(--sl-color-accent);

    /* Font */
    --scalar-font: "Open Sans", sans-serif;
    --scalar-font-medium: "Open Sans", sans-serif;
    --scalar-font-code:
      "SF Mono", Monaco, "Cascadia Code", "Roboto Mono", monospace;
  }

  /* ── API Reference Page Layout Overrides ── */

  /* Hide Starlight's empty first content-panel (rendered for PageTitle) */
  main:has([data-scalar-client]) > .content-panel:first-child {
    display: none !important;
  }

  /* Reset content panel & container spacing for full-width Scalar integration */
  main:has([data-scalar-client]) > .content-panel {
    display: flow-root !important;
    padding: 0 !important;
  }

  main:has([data-scalar-client]) .sl-container {
    max-width: 100% !important;
    padding: 0 !important;
    margin: 0 !important;
  }

  [data-scalar-client],
  main:has([data-scalar-client]) .scalar-app {
    margin-top: 0 !important;
    --scalar-custom-header-height: 0px;
  }

  /* ── Scalar Test Request Modal Z-Index Fix ──
     Elevate the API client modal and overlay ONLY when the modal is active (.scalar-client--open).
     This ensures the Test Request modal appears above the site header without affecting
     the sidebar during normal page browsing. */
  :has(.scalar-client--open) .main-pane {
    isolation: auto !important;
  }

  .scalar-client--open,
  .agent-scalar-overlay {
    z-index: 1000 !important;
  }
</style>
