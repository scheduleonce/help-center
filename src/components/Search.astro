              ></path>
            </svg>
          </a>
        </div>
      </div>
    </div>
  </dialog>
</div>

<script is:inline>
  (() => {
    const kbd = document.getElementById("search-kbd");
    if (!kbd) return;
    const pk = kbd.querySelector("kbd");
    if (pk && /(Mac|iPhone|iPod|iPad)/i.test(navigator.platform)) {
      pk.textContent = "\u2318";
      document
        .getElementById("search-trigger-btn")
        ?.setAttribute("aria-keyshortcuts", "Meta+K");
    }
    kbd.style.display = "";
  })();
</script>

<script>
  import { liteClient as algoliasearch } from "algoliasearch/lite";

  interface AlgoliaHit {
    objectID: string;
    url: string;
    url_without_anchor?: string;
    anchor?: string;
    content?: string | null;
    type?: string;
    tags?: string[];
    hierarchy?: {
      lvl0?: string | null;
      lvl1?: string | null;
      lvl2?: string | null;
      lvl3?: string | null;
      lvl4?: string | null;
      lvl5?: string | null;
      lvl6?: string | null;
    };
    _highlightResult?: {
      hierarchy?: {
        lvl0?: { value: string };
        lvl1?: { value: string };
        lvl2?: { value: string };
        lvl3?: { value: string };
        lvl4?: { value: string };
      };
      content?: { value: string };
    };
    _snippetResult?: {
      content?: { value: string };
    };
  }

  interface GroupedSubResult {
    title: string;
    url: string;
    excerpt?: string;
  }

  interface GroupedCard {
    url: string;
    title: string;
    product: string;
    contentType: string;
    excerpt?: string;
    subResults: GroupedSubResult[];
  }

  const APP_ID = import.meta.env.PUBLIC_ALGOLIA_APP_ID || "ASQ14OYWKD";
  const API_KEY =
    import.meta.env.PUBLIC_ALGOLIA_API_KEY ||
    "fb79594217c5dea48f3a5263d89eec2d";
  const INDEX_NAME =
    import.meta.env.PUBLIC_ALGOLIA_INDEX_NAME || "OnceHub Help Crawler";

  const searchClient = algoliasearch(APP_ID, API_KEY);

  const PAGE_SIZE = 5;
  let rawCards: GroupedCard[] = [];
  let visibleCount = PAGE_SIZE;

  const btn = document.getElementById(
    "search-trigger-btn",
  ) as HTMLButtonElement;
  const dialog = document.getElementById(
    "starlight-search-modal",
  ) as HTMLDialogElement;
  const input = document.getElementById(
    "starlight-search-input",
  ) as HTMLInputElement;
  const clearBtn = document.getElementById(
    "starlight-search-clear",
  ) as HTMLButtonElement;
  const cancelBtn = document.getElementById(
    "pf-modal-cancel",
  ) as HTMLButtonElement;
  const summaryEl = document.getElementById(
    "starlight-search-summary",
  ) as HTMLElement;
  const resultsEl = document.getElementById(
    "starlight-search-results",
  ) as HTMLElement;

  function formatProduct(val: string): string {
    if (!val) return "";
    if (val.toLowerCase() === "oncehub") return "OnceHub";
    if (val.toLowerCase() === "scheduleonce") return "ScheduleOnce";
    return val;
  }

  function formatContentType(val: string): string {
    if (!val) return "";
    if (
      val.toLowerCase() === "user-guides" ||
      val.toLowerCase() === "user guide" ||
      val.toLowerCase() === "help documentation"
    )
      return "User Guide";
    if (val.toLowerCase() === "developer-docs") return "Developer Docs";
    return val;
  }

  function openSearch() {
    if (!dialog) return;
    if (typeof dialog.showModal === "function") {
      dialog.showModal();
    } else {
      dialog.setAttribute("open", "");
    }
    setTimeout(() => input?.focus(), 50);
  }

  function closeSearch() {
    if (!dialog) return;
    if (dialog.open) {
      if (typeof dialog.close === "function") {
        dialog.close();
      } else {
        dialog.removeAttribute("open");
      }
    }
  }

  if (btn && dialog) {
    btn.addEventListener("click", openSearch);
    cancelBtn?.addEventListener("click", closeSearch);

    window.addEventListener("open-starlight-search", openSearch);

    // Close on clicking backdrop
    dialog.addEventListener("click", (e) => {
      if (e.target === dialog) closeSearch();
    });

    // Keyboard shortcuts: Escape to close, Ctrl+K / Cmd+K to toggle
    window.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && dialog.open) {
        e.preventDefault();
        closeSearch();
        return;
      }

      if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === "k") {
        const tag = (e.target as Element)?.tagName;
        if (tag === "INPUT" || tag === "TEXTAREA") return;
        e.preventDefault();
        if (dialog.open) {
          closeSearch();
        } else {
          openSearch();
        }
      }
    });

    if (clearBtn && input) {
      clearBtn.addEventListener("click", () => {
        input.value = "";
        clearBtn.hidden = true;
        performSearch();
        input.focus();
      });
    }

    input?.addEventListener("input", () => {
      if (clearBtn) clearBtn.hidden = !input.value;
      performSearch();
    });

    // Issue #283: Enforce minimum of one selection per filter group
    document
      .querySelectorAll<HTMLInputElement>('.pf-checkbox input[type="checkbox"]')
      .forEach((cb) => {
        cb.addEventListener("change", () => {
          const groupName = cb.name;
          const checkedInGroup = document.querySelectorAll<HTMLInputElement>(
            `.pf-checkbox input[name="${groupName}"]:checked`,
          );
          if (checkedInGroup.length === 0) {
            // Revert - user cannot uncheck all options in a category
            cb.checked = true;
            return;
          }
          performSearch();
        });
      });

    async function performSearch() {
      const term = input?.value.trim() || "";

      const checkedProducts = Array.from(
        document.querySelectorAll<HTMLInputElement>(
          '.pf-checkbox input[name="products"]:checked',
        ),
      ).map((cb) => cb.value);

      const checkedContentType = Array.from(
        document.querySelectorAll<HTMLInputElement>(
          '.pf-checkbox input[name="contentType"]:checked',
        ),
      ).map((cb) => cb.value);

      if (checkedProducts.length === 0 || checkedContentType.length === 0) {
        summaryEl.innerHTML = term
          ? `<span class="pf-summary-text">0 Results for "${escapeHtml(term)}"</span>`
          : "";
        resultsEl.innerHTML = term
          ? `<div class="pf-no-results">No results found for "${escapeHtml(term)}".</div>`
          : "";
        rawCards = [];
        visibleCount = PAGE_SIZE;
        return;
      }

      if (!term) {
        summaryEl.innerHTML = "";
        resultsEl.innerHTML = "";
        rawCards = [];
        visibleCount = PAGE_SIZE;
        return;
      }

      // Build server-side facetFilters for Algolia
      const facetFilters: (string | string[])[] = [];

      if (checkedProducts.length < 2) {
        facetFilters.push(checkedProducts.map((p) => `tags:${p}`));
      }

      if (checkedContentType.length < 2) {
        facetFilters.push(checkedContentType.map((c) => `tags:${c}`));
      }

      try {
        const response = await searchClient.search<AlgoliaHit>({
          requests: [
            {
              indexName: INDEX_NAME,
              query: term,
              facetFilters,
              attributesToRetrieve: [
                "hierarchy",
                "content",
                "anchor",
                "url",
                "url_without_anchor",
                "type",
                "tags",
              ],
              hitsPerPage: 50,
            },
          ],
        });

        const hits =
          (response.results[0] as { hits: AlgoliaHit[] })?.hits || [];

        // Group hits by page URL
        const groups = new Map<string, GroupedCard>();

        for (const hit of hits) {
          const fullUrl = hit.url_without_anchor || hit.url || "";
          const pathOnly = fullUrl.split("#")[0].split("?")[0];
          let cleanUrl = pathOnly.replace(/^https?:\/\/[^/]+/, "") || "/";
          if (!cleanUrl.endsWith("/") && !/\.[a-zA-Z0-9]+$/.test(cleanUrl)) {
            cleanUrl += "/";
          }

          const hitTags: string[] = Array.isArray(hit.tags) ? hit.tags : [];

          const prod = hitTags.includes("scheduleonce")
            ? "scheduleonce"
            : hitTags.includes("oncehub")
              ? "oncehub"
              : cleanUrl.toLowerCase().includes("/scheduleonce")
                ? "scheduleonce"
                : "oncehub";

          const cType = hitTags.includes("developer-docs")
            ? "developer-docs"
            : hitTags.includes("user-guides")
              ? "user-guides"
              : cleanUrl.toLowerCase().includes("/developers")
                ? "developer-docs"
                : "user-guides";

          if (
            !checkedProducts.includes(prod) ||
            !checkedContentType.includes(cType)
          ) {
            continue;
          }

          if (!groups.has(cleanUrl)) {
            const rawTitle =
              hit.hierarchy?.lvl1 || hit.hierarchy?.lvl0 || "Untitled Article";
            const highTitle = hit._highlightResult?.hierarchy?.lvl1?.value;
            const cardTitle =
              highTitle &&
              highTitle.includes("algolia-docsearch-suggestion--highlight")
                ? highTitle
                : escapeHtml(rawTitle);

            groups.set(cleanUrl, {
              url: cleanUrl,
              title: cardTitle,
              product: prod,
              contentType: cType,
              subResults: [],
            });
          }

          const group = groups.get(cleanUrl)!;
          const subTitle =
            hit._highlightResult?.hierarchy?.lvl2?.value ||
            hit.hierarchy?.lvl2 ||
            hit._highlightResult?.hierarchy?.lvl3?.value ||
            hit.hierarchy?.lvl3 ||
            hit._highlightResult?.hierarchy?.lvl4?.value ||
            hit.hierarchy?.lvl4;

          const excerpt =
            hit._snippetResult?.content?.value ||
            hit._highlightResult?.content?.value ||
            hit.content ||
            "";

          const anchorMatch = (hit.url || "").match(/#.*$/);
          const hitAnchorUrl = cleanUrl + (anchorMatch ? anchorMatch[0] : "");

          if (subTitle && !group.subResults.some((s) => s.title === subTitle)) {
            group.subResults.push({
              title: subTitle,
              url: hitAnchorUrl,
              excerpt: excerpt || undefined,
            });
          } else if (excerpt && !group.excerpt) {
            group.excerpt = excerpt;
          }
        }

        rawCards = Array.from(groups.values());
        visibleCount = PAGE_SIZE;
        renderResults(term, rawCards.slice(0, visibleCount), rawCards.length);
      } catch (e) {
        console.error("Algolia search error:", e);
        resultsEl.innerHTML = `<div class="pf-no-results">An error occurred while searching. Please try again.</div>`;
      }
    }

    function renderResults(
      term: string,
      items: GroupedCard[],
      totalCount: number,
    ) {
      summaryEl.innerHTML = `<span class="pf-summary-text">${totalCount} Result${totalCount === 1 ? "" : "s"} for "${escapeHtml(term)}"</span>`;

      if (items.length === 0) {
        resultsEl.innerHTML = `<div class="pf-no-results">No results found for "${escapeHtml(term)}".</div>`;
        return;
      }

      const cardsHtml = items
        .map((card) => {
          const subResults = card.subResults || [];

          return `
            <div class="pf-result-card">
              <div class="pf-card-header">
                <div class="pf-card-title-group">
                  <svg width="16" height="20" viewBox="0 0 18 22" fill="none" class="pf-card-doc-icon" aria-hidden="true">
                    <path d="M12 1H3C1.89543 1 1 1.89543 1 3V19C1 20.1046 1.89543 21 3 21H15C16.1046 21 17 20.1046 17 19V6L12 1Z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                    <path d="M12 1V6H17" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                    <path d="M5 9H13" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                    <path d="M5 13H13" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                    <path d="M5 17H9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                  </svg>
                  <a href="${card.url}" class="pf-card-title">${card.title}</a>
                </div>
                <div class="pf-card-tags">
                  <span class="pf-badge pf-badge-product">${escapeHtml(formatProduct(card.product))}</span>
                  <span class="pf-badge pf-badge-type">${escapeHtml(formatContentType(card.contentType))}</span>
                </div>
              </div>
              ${
                subResults.length > 0
                  ? `<div class="pf-card-subresults">
                      ${subResults
                        .slice(0, 4)
                        .map(
                          (sub) => `
                        <a href="${sub.url}" class="pf-sub-item">
                          <span class="pf-sub-title">${sub.title}</span>
                          ${sub.excerpt ? `<p class="pf-sub-excerpt">${sub.excerpt}</p>` : ""}
                        </a>
                      `,
                        )
                        .join("")}
                    </div>`
                  : card.excerpt
                    ? `<div class="pf-card-subresults">
                      <a href="${card.url}" class="pf-sub-item">
                        <p class="pf-sub-excerpt">${card.excerpt}</p>
                      </a>
                    </div>`
                    : ""
              }
            </div>
          `;
        })
        .join("");

      const hasMore = visibleCount < totalCount;
      const loadMoreBtnHtml = hasMore
        ? `<div class="pf-load-more-container">
            <button id="pf-load-more-btn" type="button" class="pf-load-more-btn">Load more results</button>
           </div>`
        : "";

      resultsEl.innerHTML = cardsHtml + loadMoreBtnHtml;

      if (hasMore) {
        document
          .getElementById("pf-load-more-btn")
          ?.addEventListener("click", () => {
            visibleCount += PAGE_SIZE;
            renderResults(
              term,
              rawCards.slice(0, visibleCount),
              rawCards.length,
            );
          });
      }
    }

    function escapeHtml(str: string): string {
      return str
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;");
    }
  }
</script>

