---
// src/components/Search.astro
const { entry } = Astro.locals.starlightRoute;
const products: string[] = entry.data?.products ?? [];
const contentType: string | undefined = entry.data?.contentType;
---

<!-- Metadata + filters for Pagefind indexing (hidden from view) -->{
  products.map((p) => (
    <span
      data-pagefind-filter="products"
      data-pagefind-meta={`products:${p}`}
      style="display:none"
    >
      {p}
    </span>
  ))
}
{
  contentType && (
    <span
      data-pagefind-filter="contentType"
      data-pagefind-meta={`contentType:${contentType}`}
      style="display:none"
    >
      {contentType}
    </span>
  )
}

<div class="site-search-wrapper">
  <button
    class="search-trigger-btn"
    id="search-trigger-btn"
    type="button"
    aria-label="Search"
    aria-keyshortcuts="Control+K"
  >
    <svg
      width="20"
      height="20"
      viewBox="0 0 20 20"
      fill="none"
      aria-hidden="true"
    >
      <circle cx="9" cy="9" r="7.5" stroke="currentColor" stroke-width="1.5"
      ></circle>
      <path
        d="M14 14L18.5 18.5"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"></path>
    </svg>
    <span>Search</span>
    <kbd id="search-kbd" style="display:none">
      <kbd>Ctrl</kbd>
      <kbd>K</kbd>
    </kbd>
  </button>

  <dialog id="starlight-search-modal" aria-label="Search">
    <div class="pf-modal-frame">
      <div class="pf-modal-header">
        <div class="pf-input-wrapper">
          <svg
            width="20"
            height="20"
            viewBox="0 0 20 20"
            fill="none"
            class="pf-input-icon"
            aria-hidden="true"
          >
            <circle
              cx="9"
              cy="9"
              r="7.5"
              stroke="currentColor"
              stroke-width="1.5"></circle>
            <path
              d="M14 14L18.5 18.5"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"></path>
          </svg>
          <input
            id="starlight-search-input"
            type="search"
            placeholder="Search"
            autocomplete="off"
          />
          <button
            type="button"
            class="pf-input-clear"
            id="starlight-search-clear"
            aria-label="Clear search"
            hidden
          >
            ✕
          </button>
        </div>
      </div>

      <div class="pf-modal-body">
        <div class="pf-filter-row">
          <div class="pf-filter-group">
            <span class="pf-filter-heading">Platform</span>
            <label
              class="pf-checkbox"
              data-filter="products"
              data-value="oncehub"
            >
              <input type="checkbox" name="products" value="oncehub" /> OnceHub
            </label>
            <label
              class="pf-checkbox"
              data-filter="products"
              data-value="scheduleonce"
            >
              <input type="checkbox" name="products" value="scheduleonce" /> ScheduleOnce
            </label>
          </div>
          <div class="pf-filter-group">
            <span class="pf-filter-heading">Content Type</span>
            <label
              class="pf-checkbox"
              data-filter="contentType"
              data-value="user-guides"
            >
              <input type="checkbox" name="contentType" value="user-guides" /> Help
              Documentation
            </label>
            <label
              class="pf-checkbox"
              data-filter="contentType"
              data-value="developer-docs"
            >
              <input
                type="checkbox"
                name="contentType"
                value="developer-docs"
              /> Developer Docs
            </label>
          </div>
        </div>

        <div id="starlight-search-summary" class="pf-summary"></div>
        <div id="starlight-search-results" class="pf-results"></div>
      </div>
    </div>
  </dialog>
</div>

<script is:inline>
  (() => {
    const kbd = document.getElementById("search-kbd");
    if (!kbd) return;
    const pk = kbd.querySelector("kbd");
    if (pk && /(Mac|iPhone|iPod|iPad)/i.test(navigator.platform)) {
      pk.textContent = "\u2318";
      document
        .getElementById("search-trigger-btn")
        ?.setAttribute("aria-keyshortcuts", "Meta+K");
    }
    kbd.style.display = "";
  })();
</script>

<script>
  interface PagefindSubResult {
    title?: string;
    url?: string;
    excerpt?: string;
  }

  interface PagefindResultData {
    url?: string;
    title?: string;
    meta?: {
      title?: string;
      products?: string | string[];
      contentType?: string | string[];
    };
    products?: string | string[];
    contentType?: string | string[];
    excerpt?: string;
    sub_results?: PagefindSubResult[];
  }

  interface PagefindResultRef {
    id: string;
    data: () => Promise<PagefindResultData>;
  }

  interface PagefindSearchResult {
    results: PagefindResultRef[];
  }

  interface PagefindInstance {
    init: () => Promise<void>;
    search: (
      term: string,
      options?: { filters?: Record<string, string[]> },
    ) => Promise<PagefindSearchResult>;
  }

  let pagefindInstance: PagefindInstance | null = null;
  const PAGE_SIZE = 5;
  let rawResults: PagefindResultRef[] = [];
  let visibleCount = PAGE_SIZE;

  const btn = document.getElementById(
    "search-trigger-btn",
  ) as HTMLButtonElement;
  const dialog = document.getElementById(
    "starlight-search-modal",
  ) as HTMLDialogElement;
  const input = document.getElementById(
    "starlight-search-input",
  ) as HTMLInputElement;
  const clearBtn = document.getElementById(
    "starlight-search-clear",
  ) as HTMLButtonElement;
  const summaryEl = document.getElementById(
    "starlight-search-summary",
  ) as HTMLElement;
  const resultsEl = document.getElementById(
    "starlight-search-results",
  ) as HTMLElement;

  function formatProduct(val: string): string {
    if (!val) return "";
    if (val.toLowerCase() === "oncehub") return "OnceHub";
    if (val.toLowerCase() === "scheduleonce") return "ScheduleOnce";
    return val;
  }

  function formatContentType(val: string): string {
    if (!val) return "";
    if (
      val.toLowerCase() === "user-guides" ||
      val.toLowerCase() === "help documentation"
    )
      return "User Guides";
    if (val.toLowerCase() === "developer-docs") return "Developer Docs";
    return val;
  }

  function openSearch() {
    if (!dialog) return;
    if (typeof dialog.showModal === "function") {
      dialog.showModal();
    } else {
      dialog.setAttribute("open", "");
    }
    document.body.toggleAttribute("data-search-modal-open", true);
    setTimeout(() => input?.focus(), 50);
  }

  function closeSearch() {
    if (!dialog) return;
    if (typeof dialog.close === "function") {
      dialog.close();
    } else {
      dialog.removeAttribute("open");
    }
    document.body.toggleAttribute("data-search-modal-open", false);
  }

  if (btn && dialog) {
    btn.addEventListener("click", openSearch);

    // Close on clicking backdrop
    dialog.addEventListener("click", (e) => {
      if (e.target === dialog) closeSearch();
    });

    // Keyboard shortcut Ctrl+K / Cmd+K
    window.addEventListener("keydown", (e) => {
      if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === "k") {
        const tag = (e.target as Element)?.tagName;
        if (tag === "INPUT" || tag === "TEXTAREA") return;
        e.preventDefault();
        if (dialog.open) {
          closeSearch();
        } else {
          openSearch();
        }
      }
    });

    if (clearBtn && input) {
      clearBtn.addEventListener("click", () => {
        input.value = "";
        clearBtn.hidden = true;
        performSearch();
        input.focus();
      });
    }

    input?.addEventListener("input", () => {
      if (clearBtn) clearBtn.hidden = !input.value;
      performSearch();
    });

    document
      .querySelectorAll<HTMLInputElement>('.pf-checkbox input[type="checkbox"]')
      .forEach((cb) => {
        cb.addEventListener("change", performSearch);
      });

    async function performSearch() {
      const term = input?.value.trim() || "";
      const selectedFilters: Record<string, string[]> = {};

      document
        .querySelectorAll<HTMLInputElement>(
          '.pf-checkbox input[type="checkbox"]:checked',
        )
        .forEach((cb) => {
          const group = cb.name;
          const val = cb.value;
          if (group && val) {
            (selectedFilters[group] ??= []).push(val);
          }
        });

      if (!term) {
        summaryEl.innerHTML = "";
        resultsEl.innerHTML = "";
        rawResults = [];
        visibleCount = PAGE_SIZE;
        return;
      }

      if (pagefindInstance) {
        const instance = pagefindInstance;
        try {
          const searchOptions: { filters?: Record<string, string[]> } = {};
          if (Object.keys(selectedFilters).length > 0) {
            searchOptions.filters = selectedFilters;
          }
          const searchRes = await instance.search(term, searchOptions);
          rawResults = searchRes.results;
          visibleCount = PAGE_SIZE;

          await loadAndRenderBatch(term);
        } catch (e) {
          console.error("Pagefind search error:", e);
        }
      }
    }

    async function loadAndRenderBatch(term: string) {
      const chunk = rawResults.slice(0, visibleCount);
      const items = await Promise.all(
        chunk.map((r: PagefindResultRef) => r.data()),
      );
      renderResults(term, items, rawResults.length);
    }

    function renderResults(
      term: string,
      items: PagefindResultData[],
      totalCount: number,
    ) {
      summaryEl.innerHTML = `<span class="pf-summary-text">${totalCount} Result${totalCount === 1 ? "" : "s"} for "${escapeHtml(term)}"</span>`;

      if (items.length === 0) {
        resultsEl.innerHTML = `<div class="pf-no-results">No results found for "${escapeHtml(term)}".</div>`;
        return;
      }

      const cardsHtml = items
        .map((item) => {
          const title = item.meta?.title || item.title || "Untitled Article";
          const url = item.url || "#";

          let prod = item.meta?.products || item.products || "";
          if (Array.isArray(prod)) prod = prod[0];

          let cType = item.meta?.contentType || item.contentType || "";
          if (Array.isArray(cType)) cType = cType[0];

          const subResults = item.sub_results || [];

          return `
            <div class="pf-result-card">
              <div class="pf-card-header">
                <a href="${url}" class="pf-card-title">${escapeHtml(title)}</a>
                <div class="pf-card-tags">
                  ${prod ? `<span class="pf-badge pf-badge-product">${escapeHtml(formatProduct(prod))}</span>` : ""}
                  ${cType ? `<span class="pf-badge pf-badge-type">${escapeHtml(formatContentType(cType))}</span>` : ""}
                </div>
              </div>
              ${
                subResults.length > 0
                  ? `<div class="pf-card-subresults">
                      ${subResults
                        .slice(0, 4)
                        .map(
                          (sub: PagefindSubResult) => `
                        <div class="pf-sub-item">
                          <a href="${sub.url || "#"}" class="pf-sub-title">${escapeHtml(sub.title || "Article Heading")}</a>
                          ${sub.excerpt ? `<p class="pf-sub-excerpt">${sub.excerpt}</p>` : ""}
                        </div>
                      `,
                        )
                        .join("")}
                    </div>`
                  : item.excerpt
                    ? `<div class="pf-card-subresults">
                      <div class="pf-sub-item">
                        <p class="pf-sub-excerpt">${item.excerpt}</p>
                      </div>
                    </div>`
                    : ""
              }
            </div>
          `;
        })
        .join("");

      const hasMore = visibleCount < totalCount;
      const loadMoreBtnHtml = hasMore
        ? `<div class="pf-load-more-container">
            <button id="pf-load-more-btn" type="button" class="pf-load-more-btn">Load more results</button>
           </div>`
        : "";

      resultsEl.innerHTML = cardsHtml + loadMoreBtnHtml;

      if (hasMore) {
        document
          .getElementById("pf-load-more-btn")
          ?.addEventListener("click", async () => {
            visibleCount += PAGE_SIZE;
            await loadAndRenderBatch(term);
          });
      }
    }

    function escapeHtml(str: string): string {
      return str
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;");
    }

    // Load Pagefind dynamically
    const pagefindPath =
      (import.meta.env.BASE_URL.replace(/\/$/, "") || "") +
      "/pagefind/pagefind.js";
    import(/* @vite-ignore */ pagefindPath)
      .then(async (pf) => {
        await pf.init();
        pagefindInstance = pf;
      })
      .catch((err) => {
        console.error("Failed to load Pagefind index:", err);
      });
  }
</script>

<style is:global>
  /* Modal Backdrop & Dialog container */
  #starlight-search-modal {
    position: fixed;
    top: 50px;
    left: 50%;
    transform: translateX(-50%);
    margin: 0;
    border: none;
    border-radius: 12px;
    padding: 0;
    width: 90vw;
    max-width: 740px;
    max-height: min(85vh, 750px);
    background: #ffffff;
    box-shadow:
      0 20px 25px -5px rgba(0, 0, 0, 0.15),
      0 10px 10px -5px rgba(0, 0, 0, 0.08);
    overflow: hidden;
    z-index: 9999;
  }

  #starlight-search-modal::backdrop {
    background: rgba(0, 0, 0, 0.4);
    backdrop-filter: blur(2px);
  }

  :root[data-theme="dark"] #starlight-search-modal {
    background: #1e293b;
    color: #f8fafc;
    box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.5);
  }

  .pf-modal-frame {
    display: flex;
    flex-direction: column;
    max-height: min(85vh, 750px);
  }

  .pf-modal-header {
    padding: 20px 24px 16px;
    border-bottom: 1px solid #f1f5f9;
  }

  :root[data-theme="dark"] .pf-modal-header {
    border-bottom-color: #334155;
  }

  .pf-input-wrapper {
    position: relative;
    display: flex;
    align-items: center;
  }

  .pf-input-icon {
    position: absolute;
    left: 14px;
    width: 20px;
    height: 20px;
    color: #64748b;
    pointer-events: none;
  }

  #starlight-search-input {
    width: 100%;
    height: 46px;
    padding: 0 40px 0 44px;
    border: 1px solid #cbd5e1;
    border-radius: 6px;
    font-family: "Open Sans", sans-serif;
    font-size: 16px;
    color: #1e293b;
    background: #ffffff;
    outline: none;
    transition:
      border-color 0.15s,
      box-shadow 0.15s;
  }

  #starlight-search-input:focus {
    border-color: #006bb1;
    box-shadow: 0 0 0 3px rgba(0, 107, 177, 0.15);
  }

  :root[data-theme="dark"] #starlight-search-input {
    background: #0f172a;
    border-color: #334155;
    color: #f8fafc;
  }

  :root[data-theme="dark"] #starlight-search-input:focus {
    border-color: #69b3ff;
    box-shadow: 0 0 0 3px rgba(105, 179, 255, 0.2);
  }

  .pf-input-clear {
    position: absolute;
    right: 12px;
    background: none;
    border: none;
    color: #94a3b8;
    font-size: 16px;
    cursor: pointer;
    padding: 4px;
  }

  .pf-modal-body {
    padding: 16px 24px 24px;
    overflow-y: auto;
    flex: 1;
  }

  /* Filters */
  .pf-filter-row {
    display: flex;
    gap: 36px;
    padding-bottom: 16px;
    flex-wrap: wrap;
  }

  .pf-filter-group {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
  }

  .pf-filter-heading {
    font-family: "Open Sans", sans-serif;
    font-weight: 600;
    font-size: 14px;
    color: #334155;
  }

  :root[data-theme="dark"] .pf-filter-heading {
    color: #cbd5e1;
  }

  .pf-checkbox {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: "Open Sans", sans-serif;
    font-size: 14px;
    color: #334155;
    cursor: pointer;
    user-select: none;
  }

  :root[data-theme="dark"] .pf-checkbox {
    color: #cbd5e1;
  }

  .pf-checkbox input[type="checkbox"] {
    width: 16px;
    height: 16px;
    cursor: pointer;
    accent-color: #006bb1;
    border-radius: 3px;
  }

  /* Summary */
  .pf-summary {
    font-family: "Open Sans", sans-serif;
    font-size: 14px;
    color: #64748b;
    margin-bottom: 16px;
    font-weight: 500;
  }

  :root[data-theme="dark"] .pf-summary {
    color: #94a3b8;
  }

  /* Result Card */
  .pf-result-card {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    padding: 16px 20px;
    margin-bottom: 16px;
    transition: border-color 0.15s;
  }

  .pf-result-card:hover {
    border-color: #cbd5e1;
  }

  :root[data-theme="dark"] .pf-result-card {
    background: #0f172a;
    border-color: #334155;
  }

  .pf-card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }

  .pf-card-title {
    font-family: "Open Sans", sans-serif;
    font-size: 16px;
    font-weight: 600;
    color: #1e293b;
    text-decoration: none;
  }

  .pf-card-title:hover {
    color: #006bb1;
    text-decoration: underline;
  }

  :root[data-theme="dark"] .pf-card-title {
    color: #f8fafc;
  }

  :root[data-theme="dark"] .pf-card-title:hover {
    color: #69b3ff;
  }

  .pf-card-tags {
    display: flex;
    gap: 8px;
    flex-shrink: 0;
  }

  .pf-badge {
    font-family: "Open Sans", sans-serif;
    font-size: 12px;
    font-weight: 500;
    padding: 3px 10px;
    border-radius: 4px;
    background: #f1f5f9;
    color: #475569;
  }

  :root[data-theme="dark"] .pf-badge {
    background: #1e293b;
    color: #94a3b8;
  }

  /* Sub-results */
  .pf-card-subresults {
    border-top: 1px solid #f1f5f9;
    margin-top: 12px;
    padding-top: 10px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  :root[data-theme="dark"] .pf-card-subresults {
    border-top-color: #1e293b;
  }

  .pf-sub-item {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .pf-sub-title {
    font-family: "Open Sans", sans-serif;
    font-size: 14px;
    font-weight: 600;
    color: #334155;
    text-decoration: none;
  }

  .pf-sub-title:hover {
    color: #006bb1;
  }

  :root[data-theme="dark"] .pf-sub-title {
    color: #cbd5e1;
  }

  :root[data-theme="dark"] .pf-sub-title:hover {
    color: #69b3ff;
  }

  .pf-sub-excerpt {
    font-family: "Open Sans", sans-serif;
    font-size: 13px;
    color: #64748b;
    line-height: 1.5;
    margin: 0;
  }

  :root[data-theme="dark"] .pf-sub-excerpt {
    color: #94a3b8;
  }

  .pf-sub-excerpt mark {
    background: transparent;
    color: #006bb1;
    font-weight: 600;
  }

  :root[data-theme="dark"] .pf-sub-excerpt mark {
    color: #69b3ff;
  }

  .pf-no-results {
    padding: 32px 0;
    text-align: center;
    color: #64748b;
    font-family: "Open Sans", sans-serif;
    font-size: 14px;
  }

  /* Load More button */
  .pf-load-more-container {
    display: flex;
    justify-content: center;
    padding: 16px 0 8px;
  }

  .pf-load-more-btn {
    font-family: "Open Sans", sans-serif;
    font-size: 14px;
    font-weight: 600;
    color: #006bb1;
    background: #ffffff;
    border: 1px solid #cbd5e1;
    border-radius: 6px;
    padding: 10px 24px;
    cursor: pointer;
    transition: all 0.15s ease-in-out;
  }

  .pf-load-more-btn:hover {
    background: #f0f8fd;
    border-color: #006bb1;
  }

  :root[data-theme="dark"] .pf-load-more-btn {
    background: #0f172a;
    border-color: #334155;
    color: #69b3ff;
  }

  :root[data-theme="dark"] .pf-load-more-btn:hover {
    background: #1e293b;
    border-color: #69b3ff;
  }

  [data-search-modal-open] {
    overflow: hidden;
  }
</style>
