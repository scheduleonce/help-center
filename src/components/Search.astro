---
// src/components/Search.astro
import { isDev, isScheduleOnce } from "~/utils/pathConditions";

const { entry } = Astro.locals.starlightRoute;
const pathname = Astro.url.pathname;

const isPagefindEnabled = entry.data?.pagefind !== false;

const rawProducts: string[] = entry.data?.products ?? [];
const products: string[] =
  rawProducts.length > 0
    ? rawProducts
    : isScheduleOnce(pathname)
      ? ["scheduleonce"]
      : ["oncehub"];

const contentType: string = isDev(pathname) ? "developer-docs" : "user-guides";
---

<!-- Metadata + filters for Pagefind indexing (hidden from view) -->{
  isPagefindEnabled && (
    <>
      {products.map((p) => (
        <span
          data-pagefind-filter="products"
          data-pagefind-meta={`products:${p}`}
          class="pf-meta-hidden"
        >
          {p}
        </span>
      ))}
      <span
        data-pagefind-filter="contentType"
        data-pagefind-meta={`contentType:${contentType}`}
        class="pf-meta-hidden"
      >
        {contentType}
      </span>
    </>
  )
}

<div class="site-search-wrapper">
  <button
    class="search-trigger-btn"
    id="search-trigger-btn"
    type="button"
    aria-label="Search"
    aria-keyshortcuts="Control+K"
  >
    <svg
      width="20"
      height="20"
      viewBox="0 0 20 20"
      fill="none"
      aria-hidden="true"
    >
      <circle cx="9" cy="9" r="7.5" stroke="currentColor" stroke-width="1.5"
      ></circle>
      <path
        d="M14 14L18.5 18.5"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"></path>
    </svg>
    <span>Search</span>
    <kbd id="search-kbd" class="pf-meta-hidden">
      <kbd>Ctrl</kbd>
      <kbd>K</kbd>
    </kbd>
  </button>

  <dialog id="starlight-search-modal" aria-label="Search">
    <div class="pf-modal-frame">
      <div class="pf-modal-header">
        <div class="pf-input-wrapper">
          <svg
            width="20"
            height="20"
            viewBox="0 0 20 20"
            fill="none"
            class="pf-input-icon"
            aria-hidden="true"
          >
            <circle
              cx="9"
              cy="9"
              r="7.5"
              stroke="currentColor"
              stroke-width="1.5"></circle>
            <path
              d="M14 14L18.5 18.5"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"></path>
          </svg>
          <input
            id="starlight-search-input"
            type="search"
            placeholder="Search"
            autocomplete="off"
          />
          <button
            type="button"
            class="pf-input-clear"
            id="starlight-search-clear"
            aria-label="Clear search"
            hidden
          >
            <svg
              width="14"
              height="14"
              viewBox="0 0 14 14"
              fill="none"
              aria-hidden="true"
            >
              <path
                d="M1 1L13 13M1 13L13 1"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"></path>
            </svg>
          </button>
        </div>
        <button type="button" class="pf-modal-cancel" id="pf-modal-cancel">
          Cancel
        </button>
      </div>

      <div class="pf-modal-body">
        <div class="pf-filter-row">
          <div class="pf-filter-group">
            <span class="pf-filter-heading">Platform</span>
            <label
              class="pf-checkbox"
              data-filter="products"
              data-value="oncehub"
            >
              <input type="checkbox" name="products" value="oncehub" checked /> OnceHub
            </label>
            <label
              class="pf-checkbox"
              data-filter="products"
              data-value="scheduleonce"
            >
              <input
                type="checkbox"
                name="products"
                value="scheduleonce"
                checked
              /> ScheduleOnce
            </label>
          </div>
          <div class="pf-filter-group">
            <span class="pf-filter-heading">Content Type</span>
            <label
              class="pf-checkbox"
              data-filter="contentType"
              data-value="user-guides"
            >
              <input
                type="checkbox"
                name="contentType"
                value="user-guides"
                checked
              /> User Guide
            </label>
            <label
              class="pf-checkbox"
              data-filter="contentType"
              data-value="developer-docs"
            >
              <input
                type="checkbox"
                name="contentType"
                value="developer-docs"
                checked
              /> Developer Docs
            </label>
          </div>
        </div>

        <div id="starlight-search-summary" class="pf-summary"></div>
        <div id="starlight-search-results" class="pf-results"></div>

        <div class="pf-algolia-footer">
          <a
            href="https://www.algolia.com/ref/docsearch/?utm_source=help.oncehub.com&utm_medium=referral&utm_content=powered_by&utm_campaign=docsearch"
            target="_blank"
            rel="noopener noreferrer"
            class="pf-algolia-credit"
          >
            <span class="pf-algolia-label">Search by</span>
            <svg
              width="68"
              height="16"
              aria-label="Algolia"
              role="img"
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 2196.2 500"
            >
              <path
                class="cls-algolia-2"
                d="M1070.38,275.3V5.91c0-3.63-3.24-6.39-6.82-5.83l-50.46,7.94c-2.87,.45-4.99,2.93-4.99,5.84l.17,273.22c0,12.92,0,92.7,95.97,95.49,3.33,.1,6.09-2.58,6.09-5.91v-40.78c0-2.96-2.19-5.51-5.12-5.84-34.85-4.01-34.85-47.57-34.85-54.72Z"
              ></path>
              <rect
