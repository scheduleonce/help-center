---
import { logos } from "virtual:starlight/user-images";
import config from "virtual:starlight/user-config";

const { siteTitleHref, siteTitle } = Astro.locals.starlightRoute;
const isScheduleOnce = Astro.url.pathname.startsWith("/scheduleonce");
---

<a href={siteTitleHref} class="site-title sl-flex">
  {
    isScheduleOnce ? (
      <img src="/assets/so-logo.png" alt="ScheduleOnce Help" class="so-logo" />
    ) : (
      <>
        {config.logo && logos.dark && (
          <img
            class:list={{
              "light:sl-hidden print:hidden": !("src" in config.logo),
            }}
            alt={config.logo.alt}
            src={logos.dark.src}
            width={logos.dark.width}
            height={logos.dark.height}
          />
        )}
        <span
          class:list={{ "sr-only": config.logo?.replacesTitle }}
          translate="no"
        >
          {siteTitle}
        </span>
      </>
    )
  }
</a>

<style>
  @layer starlight.core {
    .site-title {
      align-items: center;
      gap: var(--sl-nav-gap);
      font-size: 1.5rem;
      font-weight: 400;
      color: var(--sl-color-text-accent);
      text-decoration: none;
      white-space: nowrap;
      min-width: 0;
    }
    span {
      overflow: hidden;
    }
    img {
      height: 40px;
      width: auto;
      max-width: 100%;
      object-fit: contain;
      object-position: 0 50%;
    }
    .so-logo {
      /* The PNG is large; cap it to fit the nav bar */
      max-height: 40px;
      width: auto;
    }
  }
</style>
