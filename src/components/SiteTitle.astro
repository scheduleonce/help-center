---
import { isScheduleOnce } from "~/utils/pathConditions";

const { siteTitleHref } = Astro.locals.starlightRoute;
const path = Astro.url.pathname;
const isSo = isScheduleOnce(path);
import { isHomepage } from "~/utils/pathConditions";
---

<a href={siteTitleHref} class="site-title sl-flex">
  {
    isSo ? (
      <>
        <img
          src="/assets/so-logo.svg"
          alt="ScheduleOnce Help"
          class="so-logo so-logo-light"
        />
        <img
          src="/assets/so-logo-dark.svg"
          alt="ScheduleOnce Help"
          class="so-logo so-logo-dark"
        />
      </>
    ) : (
      <>
        <img
          src="/assets/oh-logo.svg"
          alt="OnceHub Logo"
          class="oh-logo oh-logo-light"
        />
        <img
          src="/assets/oh-logo-white.svg"
          alt="OnceHub Logo"
          class="oh-logo oh-logo-dark"
        />
        <span class="logo-text">{isHomepage(path) && "Help"}</span>
      </>
    )
  }
</a>

<style>
  @layer starlight.core {
    .site-title {
      align-items: center;
      /* gap: 8px; */
      font-size: 1.5rem;
      font-weight: 400;
      color: var(--sl-color-accent);
      text-decoration: none;
      white-space: nowrap;
      min-width: 0;
    }
    img {
      height: 40px;
      width: auto;
      max-width: 100%;
      object-fit: contain;
      object-position: 0 50%;
    }
    .logo-text {
      display: inline-block;
      font-size: 1.5rem;
      line-height: 1.875rem;
      font-weight: 400;
      color: #333;
      margin-top: 6px;
    }
    .oh-icon {
      height: 30px;
      width: 30px;
    }
    .oh-logo {
      height: 35px;
    }
    .so-logo {
      height: 28px;
    }
    .oh-logo-dark,
    .so-logo-dark {
      display: none;
    }
    :root[data-theme="dark"] .oh-logo-light,
    :root[data-theme="dark"] .so-logo-light {
      display: none;
    }
    :root[data-theme="dark"] .oh-logo-dark,
    :root[data-theme="dark"] .so-logo-dark {
      display: inline-block;
    }
    :root[data-theme="dark"] .logo-text {
      color: #fff;
    }
    .so-logo {
      max-height: 40px;
      width: auto;
    }
  }
</style>
