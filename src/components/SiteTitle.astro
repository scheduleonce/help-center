---
import { isScheduleOnce } from "~/utils/pathConditions";

const { siteTitleHref } = Astro.locals.starlightRoute;
const path = Astro.url.pathname;
const isSo = isScheduleOnce(path);
---

<a href={siteTitleHref} class="site-title sl-flex">
  {
    isSo ? (
      <img src="/assets/so-logo.png" alt="ScheduleOnce Help" class="so-logo" />
    ) : (
      <img
        src="/assets/oh-logo.svg"
        alt="OnceHub Logo"
        class="oh-logo"
        width="150"
        height="41"
      />
    )
  }
</a>

<style>
  @layer starlight.core {
    .site-title {
      align-items: center;
      gap: 8px;
      font-size: 1.5rem;
      font-weight: 400;
      color: var(--sl-color-text-accent);
      text-decoration: none;
      white-space: nowrap;
      min-width: 0;
    }
    img {
      height: 40px;
      width: auto;
      max-width: 100%;
      object-fit: contain;
      object-position: 0 50%;
    }
    .oh-icon {
      height: 30px;
      width: 30px;
    }
    .oh-logo {
      height: 41px;
    }
    .so-logo {
      max-height: 40px;
      width: auto;
    }
  }
</style>
