---
import type { Props } from "@astrojs/starlight/props";
---

<div class="header-content-wrapper">
  <nav class="header-links">
    <a href="https://support.oncehub.com/" class="support-cta">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        width="18"
        height="18"
        fill="white"
      >
        <path
          d="M20 2H4c-1.1 0-2 .9-2 2v18l4-4h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2z"
        ></path>
      </svg>
      Support
    </a>
    <a href="https://developers.oncehub.com/">Developers</a>
    <a
      href="https://www.youtube.com/playlist?list=PLbDqoI6OzOkkaEHwtL-GcZZl573tDbtMc"
      >Tutorials</a
    >
    <a href="/whats-new/our-latest-release-updates">What's New</a>
  </nav>
</div>

<style>
  .header-content-wrapper {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .header-links {
    display: none;
    align-items: center;
    gap: 1.25rem;
  }

  @media (min-width: 50rem) {
    .header-links {
      display: flex;
    }
  }

  .header-links a {
    color: var(--sl-color-text-muted);
    text-decoration: none;
    font-size: 1rem;
    line-height: 1.5rem;
    font-weight: 500;
  }

  .header-links a:hover {
    color: var(--sl-color-text-accent);
  }

  .header-links a.support-cta {
    color: white;
    background-color: #006bb1;
    height: 41px;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0 1.25rem;
    border-radius: 9999px;
    font-weight: 500;
  }

  .header-links a.support-cta:hover {
    background-color: #005a96;
    color: white;
  }
</style>
