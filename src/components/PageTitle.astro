---
import PluginPageTitle from "starlight-page-actions/overrides/PageTitle.astro";
import { Breadcrumbs } from "astro-breadcrumbs";
import "astro-breadcrumbs/breadcrumbs.css";
import { getEntry } from "astro:content";

const { template } = Astro.locals.starlightRoute.entry.data;
const isSplash = template === "splash";

// Check if this is a whats-new article page (not the index)
const slug = Astro.locals.starlightRoute.id;
const isWhatsNewArticle =
  slug.startsWith("whats-new/") && slug !== "whats-new/index";

/** Format YYYY-MM-DD to a readable date like "April 30, 2026" */
function formatDate(dateStr: string | undefined): string {
  if (!dateStr) return "";
  const [y, m, d] = dateStr.split("-").map(Number);
  const months = [
    "January",
    "February",
    "March",
    "April",
    "May",
    "June",
    "July",
    "August",
    "September",
    "October",
    "November",
    "December",
  ];
  return `${months[m - 1]} ${d}, ${y}`;
}

/** Convert a kebab-case slug segment to Title Case label. */
function segmentLabel(seg: string): string {
  return seg
    .split("-")
    .map((w) => w.charAt(0).toUpperCase() + w.slice(1))
    .join(" ");
}

// Build breadcrumbs from every URL segment, including the current page.
// Every parent crumb links to its section index page (e.g. /category/).
// If an index page exists at that path, its title is used; otherwise the
// segment slug is converted to a readable label.
interface Crumb {
  text: string;
  href: string;
  "aria-current"?: string;
}

const crumbs: Crumb[] = [];

if (!isSplash) {
  const slug = Astro.locals.starlightRoute.id;
  // Strip trailing /index so the loop doesn't include "index" as a crumb
  const cleanSlug = slug.replace(/\/index$/, "");
  const segments = cleanSlug.split("/");

  for (let i = 0; i < segments.length; i++) {
    const path = segments.slice(0, i + 1).join("/");
    const isLast = i === segments.length - 1;

    // Try exact match then /index variant (Starlight stores index.mdx as path/index)
    const entry =
      (await getEntry("docs", path)) ??
      (await getEntry("docs", `${path}/index`));

    crumbs.push({
      text: entry?.data.title ?? segmentLabel(segments[i]),
      href: `/${path}/`,
      ...(isLast ? { "aria-current": "page" } : {}),
    });
  }
}
---

{
  !isSplash && crumbs.length > 0 && (
    <Breadcrumbs crumbs={crumbs} truncated={true} indexText="Home">
      <svg
        slot="separator"
        xmlns="http://www.w3.org/2000/svg"
        width="16"
        height="16"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <polyline points="9 18 15 12 9 6" />
      </svg>
    </Breadcrumbs>
  )
}

<style is:global>
  .c-breadcrumbs {
    --size-font-breadcrumbs: 0.75rem;
    padding: 0.5rem 0;
  }
  .c-breadcrumbs__crumb {
    font-size: 0.75rem;
    line-height: 1.25rem;
  }
  .c-breadcrumbs__link {
    font-weight: 600;
  }
  .c-breadcrumbs__separator {
    color: var(--sl-color-text-accent);
  }
  .c-breadcrumbs__truncated-button {
    color: var(--sl-color-text-accent);
  }
</style>

{
  !isSplash && isWhatsNewArticle ? (
    <h1 id="_top" class="content-title">
      {formatDate(Astro.locals.starlightRoute.entry.data.date)}:{" "}
      {Astro.locals.starlightRoute.entry.data.title}
    </h1>
  ) : (
    !isSplash && <PluginPageTitle />
  )
}
